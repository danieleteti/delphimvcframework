{{include "_license_header.tpro"}}
unit {{:unit_name}};

// {{:model_class}}: the model controllers and services of {{:tag}} share. Declared once,
// here; whoever needs it adds this unit to its uses clause.

interface

uses
{{if model_ar}}
  MVCFramework.ActiveRecord,
  MVCFramework.Nullables,
{{endif}}
  MVCFramework.Validators;

type
{{if model_ar}}
  [MVCTable('{{:table_name}}')]
  {{:model_class}} = class(TMVCActiveRecord)
  private
    [MVCTableField('id', [foPrimaryKey, foAutoGenerated])]
    fID: NullableInt64;
    [MVCTableField('name')]
    fName: string;
  public
    property ID: NullableInt64 read fID write fID;
    [MVCRequired]
    property Name: string read fName write fName;
  end;
{{else}}
  {{:model_class}} = class
  private
    fID: Integer;
    fName: string;
  public
    property ID: Integer read fID write fID;
    [MVCRequired]
    property Name: string read fName write fName;
  end;
{{endif}}

implementation

end.
