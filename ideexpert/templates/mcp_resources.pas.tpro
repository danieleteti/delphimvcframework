{{include "_license_header.tpro"}}
unit Resources.SampleU;

interface

uses
  MVCFramework.MCP.ResourceProvider,
  MVCFramework.MCP.Attributes;

type
  // MCP resources: every [MCPResource] method is listed by resources/list
  TSampleResources = class(TMCPResourceProvider)
  public
    [MCPResource('info://{{:program_name}}/about', 'About',
      'What this server is', 'text/plain')]
    function GetAbout(const URI: string): TMCPResourceResult;
  end;

implementation

uses
  MVCFramework.MCP.Server;

function TSampleResources.GetAbout(const URI: string): TMCPResourceResult;
begin
  Result := TMCPResourceResult.Text(URI, '{{:program_name}}, an MCP server built with DMVCFramework', 'text/plain');
end;

initialization
  TMCPServer.Instance.RegisterResourceProvider(TSampleResources);

end.
