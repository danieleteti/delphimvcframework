{{include "_license_header.tpro"}}
unit Routes.RootU;

// Minimal API routes: versioned /api/v1 surface, one example route + Bearer-protected admin group.
// Add route groups with Project Manager > DMVCFramework > New Minimal API Route Group... (Delphi 12+)

interface

uses
  MVCFramework,
  MVCFramework.MinimalAPI;

{{if @(not webmodule_middleware_jwt)}}
const
  // Full routed path of the admin group: EngineConfigU guards it with the bearer token of .env
  ADMIN_PATH = '/api/v1/admin';

{{endif}}
procedure ConfigureRoutes(const ARoot: TMVCRouteGroup<TObject>);

implementation

uses
{{if webmodule_middleware_jwt}}
  System.DateUtils,
  MVCFramework.DotEnv,
  MVCFramework.JWT,
  MVCFramework.Filters.Authentication,
  {{:authentication_unit_name}},
{{else}}
  MVCFramework.Filters,
{{endif}}
  System.SysUtils,
  MVCFramework.Commons;

// Auth filter applied locally: every route on lAdmin requires Bearer. Use() returns a modified copy.
procedure RegisterAdminRoutes(const AGroup: TMVCRouteGroup<TObject>);
var
  lAdmin: TMVCRouteGroup<TObject>;
{{if webmodule_middleware_jwt}}
  lJWTOptions: TMVCJWTAuthenticationOptions;
{{endif}}
begin
{{if webmodule_middleware_jwt}}
  // POST /api/v1/admin/login with the jwtusername / jwtpassword headers answers {"token": "..."}.
  // The login goes on the engine (before routing), the token check covers this group only.
  lJWTOptions := TMVCJWTAuthenticationOptions.Default;
  lJWTOptions.Handler := {{:authentication_classname}}.Create;
  lJWTOptions.ClaimsSetup := procedure(const JWT: TJWT)
    begin
      JWT.Claims.Issuer := dotEnv.Env('JWT_ISSUER', '{{:program_name}}');
      JWT.Claims.ExpirationTime := Now + OneHour;
      JWT.Claims.NotBefore := Now - OneMinute * 5;
      JWT.Claims.IssuedAt := Now;
    end;
  lJWTOptions.Secret := dotEnv.Env('JWT_SECRET'); // no fallback: a missing key must fail, not sign with a public string
  lJWTOptions.LoginURL := '/api/v1/admin/login';
  lJWTOptions.ClaimsToCheck := [TJWTCheckableClaim.ExpirationTime, TJWTCheckableClaim.NotBefore, TJWTCheckableClaim.IssuedAt];
  lAdmin := AGroup.Use(JWTAuthenticationBundle(lJWTOptions));
{{else}}
  // The token is checked by BearerAuthHTTPFilter in EngineConfigU; AuthorizeEndpointFilter refuses with 401
  // anything that reaches these routes without a logged user, so a lost filter fails closed.
  lAdmin := AGroup.Use(AuthorizeEndpointFilter());
{{endif}}

  lAdmin.MapGet('/health',
    function: IMVCResponse
    begin
      Result := Ok('admin ok');
{{if program_openapi_native}}
    end)
    .WithTags('Admin')
    .WithSummary('Admin health check (Bearer token required)');
{{else}}
    end);
{{endif}}
end;

procedure ConfigureRoutes(const ARoot: TMVCRouteGroup<TObject>);
var
  lApiV1: TMVCRouteGroup<TObject>;
begin
  ARoot.MapGet('',
    function: IMVCResponse
    begin
      Result := Redirect('/api/v1/hello');
{{if program_openapi_native}}
    end)
    .WithOpenAPI(oavHidden); // a redirect, not part of the API
{{else}}
    end);
{{endif}}

  lApiV1 := ARoot.Prefix('/api/v1');

  // The example route: Ok(string) answers {"message": "..."}
  lApiV1.MapGet('/hello',
    function: IMVCResponse
    begin
      Result := Ok('Hello from {{:program_name}}');
{{if program_openapi_native}}
    end)
    .WithTags('Hello')
    .WithSummary('Example route');
{{else}}
    end);
{{endif}}

  // Auth gate is applied inside RegisterAdminRoutes.
  RegisterAdminRoutes(lApiV1.Prefix('/admin'));
end;

end.
