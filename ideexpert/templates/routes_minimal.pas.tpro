{{include "_license_header.tpro"}}
unit RoutesU;

// Minimal API routes: versioned /api/v1 surface, one example route + Bearer-protected admin group.
// Add route groups with Project Manager > DMVCFramework > New Minimal API Route Group... (Delphi 12+)

interface

uses
  MVCFramework,
  MVCFramework.MinimalAPI;

procedure ConfigureRoutes(const ARoot: TMVCRouteGroup<TObject>);

implementation

uses
{{if webmodule_middleware_jwt}}
  System.DateUtils,
  MVCFramework.DotEnv,
  MVCFramework.Filters,
  MVCFramework.JWT,
  {{:authentication_unit_name}},
{{endif}}
  System.SysUtils,
  MVCFramework.Commons;

{{if webmodule_middleware_jwt}}
// Bearer-JWT gate for the admin subtree. It also serves the login endpoint that
// lives inside the group: POST /api/v1/admin/login with jwtusername and jwtpassword
// headers returns a token. Verification happens here, in the route pipeline: the
// classic JWT middleware verifies in OnBeforeControllerAction, which a minimal-API
// route never reaches.
function BearerAuthFilter: TMVCEndpointFilter;
begin
  Result := JWT(
    {{:authentication_classname}}.Create,
    procedure(const JWT: TJWT)
    begin
      JWT.Claims.Issuer := dotEnv.Env('JWT_ISSUER', '{{:program_name}}');
      JWT.Claims.ExpirationTime := Now + OneHour;
      JWT.Claims.NotBefore := Now - OneMinute * 5;
      JWT.Claims.IssuedAt := Now;
    end,
    dotEnv.Env('JWT_SECRET'),  // no fallback: a missing key must fail, not sign with a public string
    '/api/v1/admin/login',
    [TJWTCheckableClaim.ExpirationTime, TJWTCheckableClaim.NotBefore, TJWTCheckableClaim.IssuedAt],
    300);
end;
{{else}}
// Short-circuits with 401 unless the request carries a Bearer token.
function BearerAuthFilter: TMVCEndpointFilter;
begin
  Result := function (const Ctx: TWebContext;
                       const Next: TMVCEndpointFilterNext): IMVCResponse
    var
      lAuth: string;
    begin
      // Placeholder: any Bearer string gets in. Replace with a real validator
      // (JWT signer, opaque-token store, ...) before this goes anywhere near production.
      lAuth := Ctx.Request.Headers['Authorization'];
      if not lAuth.StartsWith('Bearer ', True) then
        Exit(Status(401, 'Bearer token required'));
      Result := Next();
    end;
end;
{{endif}}

// Auth filter applied locally: every route on lAdmin requires Bearer. Use() returns a modified copy.
procedure RegisterAdminRoutes(const AGroup: TMVCRouteGroup<TObject>);
var
  lAdmin: TMVCRouteGroup<TObject>;
begin
  lAdmin := AGroup.Use(BearerAuthFilter());

  lAdmin.MapGet('/health',
    function: IMVCResponse
    begin
      Result := Ok('admin ok');
{{if program_openapi_native}}
    end)
    .WithTags('Admin')
    .WithSummary('Admin health check (Bearer token required)');
{{else}}
    end);
{{endif}}
end;

procedure ConfigureRoutes(const ARoot: TMVCRouteGroup<TObject>);
var
  lApiV1: TMVCRouteGroup<TObject>;
begin
  ARoot.MapGet('',
    function: IMVCResponse
    begin
      Result := Redirect('/api/v1/hello');
{{if program_openapi_native}}
    end)
    .WithOpenAPI(False); // a redirect, not part of the API
{{else}}
    end);
{{endif}}

  lApiV1 := ARoot.Prefix('/api/v1');

  // The example route: Ok(string) answers {"message": "..."}
  lApiV1.MapGet('/hello',
    function: IMVCResponse
    begin
      Result := Ok('Hello from {{:program_name}}');
{{if program_openapi_native}}
    end)
    .WithTags('Hello')
    .WithSummary('Example route');
{{else}}
    end);
{{endif}}

  // Auth gate is applied inside RegisterAdminRoutes via .Use(BearerAuthFilter()).
  RegisterAdminRoutes(lApiV1.Prefix('/admin'));
end;

end.
