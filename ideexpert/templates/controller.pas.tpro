{{include "_license_header.tpro"}}
unit {{:controller_unit_name}};

interface

uses
  MVCFramework, MVCFramework.Commons, MVCFramework.Serializer.Commons, System.Generics.Collections;

type
{{if program_ssv_any}}
  [MVCPath('/web')]
{{else}}
  [MVCPath('/api')]
{{endif}}
  {{:controller_classname}} = class(TMVCController)
{{if program_ssv_any}}
  protected
    procedure OnBeforeAction(Context: TWebContext; const AActionName: string; var Handled: Boolean); override;
{{if controller_action_filters_generate}}
    procedure OnAfterAction(Context: TWebContext; const AActionName: string); override;
{{endif}}
{{else}}
{{if controller_action_filters_generate}}
  protected
    procedure OnBeforeAction(Context: TWebContext; const AActionName: string; var Handled: Boolean); override;
    procedure OnAfterAction(Context: TWebContext; const AActionName: string); override;
{{endif}}
{{endif}}
{{if controller_index_methods_generate}}
  public
    [MVCPath]
    [MVCHTTPMethod([httpGET])]
    [MVCProduces(TMVCMediaType.TEXT_HTML)]
    function Index: String;
{{if program_ssv_any}}

    [MVCPath('/about')]
    [MVCHTTPMethod([httpGET])]
    [MVCProduces(TMVCMediaType.TEXT_HTML)]
    function About: String;

    // HTMX fragment endpoints — return partial HTML, no full page
    [MVCPath('/fragment/clock')]
    [MVCHTTPMethod([httpGET])]
    [MVCProduces(TMVCMediaType.TEXT_HTML)]
    function GetClockFragment: String;

    [MVCPath('/fragment/info')]
    [MVCHTTPMethod([httpGET])]
    [MVCProduces(TMVCMediaType.TEXT_HTML)]
    function GetInfoFragment: String;
{{if program_ssv_templatepro}}

    // Table example: search, status filter and sorting come from the query
    // string, so every state of the table has its own URL.
    [MVCPath('/people')]
    [MVCHTTPMethod([httpGET])]
    [MVCProduces(TMVCMediaType.TEXT_HTML)]
    function People(
      [MVCFromQueryString('q', '')] const Search: String;
      [MVCFromQueryString('status', '')] const Status: String;
      [MVCFromQueryString('sort', 'name')] const Sort: String;
      [MVCFromQueryString('dir', 'asc')] const Dir: String): String;

    // Form example: people/edit.html is built with the TemplatePro forms
    // library (templates/lib/forms_bootstrap5.tpro).
    [MVCPath('/people/($ID:int)')]
    [MVCHTTPMethod([httpGET])]
    [MVCProduces(TMVCMediaType.TEXT_HTML)]
    function EditPerson(ID: Integer): String;

    [MVCPath('/people/($ID:int)')]
    [MVCHTTPMethod([httpPOST])]
    [MVCProduces(TMVCMediaType.TEXT_HTML)]
    function SavePerson(ID: Integer): IMVCResponse;
{{endif}}
{{else}}

    [MVCPath('/reversedstrings/($Value)')]
    [MVCHTTPMethod([httpGET])]
    [MVCProduces(TMVCMediaType.TEXT_PLAIN)]
    function GetReversedString(const Value: String): String;
{{endif}}

{{endif}}
  end;

implementation

uses
  System.StrUtils, System.SysUtils{{if program_ssv_any}}, System.DateUtils{{endif}}, MVCFramework.Logger{{if program_ssv_templatepro}},
  System.Math, System.Generics.Defaults, MVCFramework.HTMX{{endif}};
{{if program_ssv_templatepro}}

{{include "_people_sample.pas.tpro"}}
{{endif}}

{{if program_ssv_any}}
procedure {{:controller_classname}}.OnBeforeAction(Context: TWebContext; const AActionName: string; var Handled: Boolean);
begin
  inherited;
  // Global ViewData available to all views (used by baselayout.html)
  ViewData['app_name'] := '{{:program_name}}';
  ViewData['dmvc_version'] := DMVCFRAMEWORK_VERSION;
  ViewData['current_year'] := YearOf(Now);
  ViewData['page_id'] := AActionName.ToLower;
end;
{{if controller_action_filters_generate}}

procedure {{:controller_classname}}.OnAfterAction(Context: TWebContext; const AActionName: string);
begin
  { Executed after each action }
  inherited;
end;
{{endif}}
{{else}}
{{if controller_action_filters_generate}}
procedure {{:controller_classname}}.OnAfterAction(Context: TWebContext; const AActionName: string);
begin
  { Executed after each action }
  inherited;
end;

procedure {{:controller_classname}}.OnBeforeAction(Context: TWebContext; const AActionName: string; var Handled: Boolean);
begin
  { Executed before each action
    if handled is true (or an exception is raised) the actual
    action will not be called }
  inherited;
end;
{{endif}}
{{endif}}

{{if controller_index_methods_generate}}
function {{:controller_classname}}.Index: String;
begin
{{if controller_actions_profiling_generate}}
{$IF CompilerVersion >= 34} //SYDNEY+
  var lProf := Profiler.Start(Context.ActionQualifiedName);
{$ENDIF}
{{endif}}
{{if program_ssv_any}}
  ViewData['current_date'] := FormatDateTime('dddd, dd mmmm yyyy', Now);
  ViewData['compiler_version'] := {$IF CompilerVersion >= 37}'Delphi 13 Florence'
    {$ELSEIF CompilerVersion >= 36}'Delphi 12 Athens'
    {$ELSEIF CompilerVersion >= 35}'Delphi 11 Alexandria'
    {$ELSEIF CompilerVersion >= 34}'Delphi 10.4 Sydney'
    {$ELSEIF CompilerVersion >= 33}'Delphi 10.3 Rio'
    {$ELSEIF CompilerVersion >= 32}'Delphi 10.2 Tokyo'
    {$ELSE}'Delphi'{$ENDIF};

  Result := RenderView('home/index');
{{else}}
  Result := '<p>Hello <strong>DelphiMVCFramework</strong> World</p>' +
            '<p><small>dmvcframework-' + DMVCFRAMEWORK_VERSION + '</small></p>';
{{endif}}
end;

{{if program_ssv_any}}
function {{:controller_classname}}.About: String;
begin
  Result := RenderView('about/index');
end;

function {{:controller_classname}}.GetClockFragment: String;
begin
  // Just the value: the page decides where it goes (hx-swap="innerHTML").
  Result := '<time datetime="' + FormatDateTime('yyyy-mm-dd"T"hh:nn:ss', Now) + '">' +
    FormatDateTime('hh:nn:ss', Now) + '</time>';
end;

function {{:controller_classname}}.GetInfoFragment: String;
begin
  Result :=
    '<dl class="meta-list">' +
    '<dt>Application</dt><dd>{{:program_name}}</dd>' +
    '<dt>DMVCFramework</dt><dd>' + DMVCFRAMEWORK_VERSION + '</dd>' +
    '<dt>Compiler</dt><dd>' + Format('Delphi %.1f', [CompilerVersion], TFormatSettings.Invariant) + '</dd>' +
    '<dt>Server time</dt><dd>' + FormatDateTime('yyyy-mm-dd hh:nn:ss', Now) + '</dd>' +
    '</dl>';
end;
{{if program_ssv_templatepro}}

function {{:controller_classname}}.People(const Search, Status, Sort, Dir: String): String;
var
  lPage: TPeoplePage;
begin
  lPage := BuildPeoplePage(Search, Status, Sort, Dir);
  try
    ViewData['people'] := lPage.Rows;
    ViewData['q'] := Search;
    ViewData['query'] := Context.Request.QueryParams; // model of the search box
    ViewData['status'] := LowerCase(Status);
    ViewData['sort'] := lPage.Sort;
    ViewData['dir'] := lPage.Dir;
    ViewData['count_all'] := lPage.CountActive + lPage.CountInvited + lPage.CountSuspended;
    ViewData['count_active'] := lPage.CountActive;
    ViewData['count_invited'] := lPage.CountInvited;
    ViewData['count_suspended'] := lPage.CountSuspended;
    ViewData['count_shown'] := lPage.Rows.Count;

    // HTMX asks for the table only (search box, sort links, filter tabs);
    // a normal request, or a browser without JavaScript, gets the whole page.
    if Context.Request.IsHTMX and not Context.Request.HXIsBoosted then
      Result := RenderView('people/table')
    else
      Result := RenderView('people/index');
  finally
    lPage.Rows.Free;
  end;
end;

function {{:controller_classname}}.EditPerson(ID: Integer): String;
var
  lPerson: TPersonRow;
begin
  lPerson := FindPerson(ID);
  if lPerson = nil then
    raise EMVCException.Create(HTTP_STATUS.NotFound, 'Person not found');
  try
    ViewData['page_id'] := 'people';
    // formModel is the variable the forms library reads the values from
    ViewData['formModel'] := lPerson;
    ViewData['person_id'] := ID;
    ViewData['roles'] := GRoles;
    ViewData['statuses'] := GStatuses;
    Result := RenderView('people/edit');
  finally
    lPerson.Free;
  end;
end;

function {{:controller_classname}}.SavePerson(ID: Integer): IMVCResponse;
var
  lPerson: TPersonRow;
  lErrors: TDictionary<String, String>;
  lPage: TMVCHTMLResponse;
begin
  lPerson := FindPerson(ID);
  if lPerson = nil then
    raise EMVCException.Create(HTTP_STATUS.NotFound, 'Person not found');
  lErrors := TDictionary<String, String>.Create; // field name -> message
  try
    ReadPerson(lPerson, Context.Request.ContentFields, lErrors);
    if lErrors.Count = 0 then
    begin
      StorePerson(lPerson);
      // Post/Redirect/Get: reloading the list does not submit the form again
      Exit(RedirectResponse('/web/people'));
    end;

    // Invalid: the same page, with what was typed and a message per field
    ViewData['page_id'] := 'people';
    ViewData['formModel'] := Context.Request.ContentFields;
    ViewData['formErrors'] := lErrors;
    ViewData['person_id'] := ID;
    ViewData['roles'] := GRoles;
    ViewData['statuses'] := GStatuses;
    lPage := TMVCHTMLResponse.Create;
    Result := lPage; // owned by the interface from here, also if RenderView raises
    lPage.StatusCode := HTTP_STATUS.UnprocessableEntity;
    lPage.HTMLBody := RenderView('people/edit');
  finally
    lErrors.Free;
    lPerson.Free;
  end;
end;
{{endif}}

{{else}}
function {{:controller_classname}}.GetReversedString(const Value: String): String;
begin
{{if controller_actions_profiling_generate}}
{$IF CompilerVersion >= 34} //SYDNEY+
  var lProf := Profiler.Start(Context.ActionQualifiedName);
{$ENDIF}
{{endif}}
  Result := System.StrUtils.ReverseString(Value.Trim);
end;
{{endif}}
{{endif}}
{{if program_ssv_templatepro}}

{{include "_people_sample_init.pas.tpro"}}
{{endif}}

end.
