{{include "_license_header.tpro"}}
unit RoutesU;

// Minimal-API web app: the same pages as the controller-based one as
// lambda routes, plus a login-protected Admin area.
// Session and login are endpoint filters (.Use); PageDefaults fills the
// ViewData every page of baselayout.html reads.

interface

uses
  MVCFramework,
  MVCFramework.MinimalAPI,
  MVCFramework.Filters;

procedure ConfigureRoutes(const ARoot: TMVCRouteGroup<TObject>);

implementation

uses
  System.SysUtils,
  System.DateUtils,
  JsonDataObjects,
  MVCFramework.Commons;

type
  // Form-urlencoded binding for POST /web/login via [MVCFromContentField]
  // (same '(name)' convention as MVCFromQueryString / MVCFromHeader).
  TLoginForm = record
    [MVCFromContentField('username')] Username: string;
    [MVCFromContentField('password')] Password: string;
  end;

// Values every page reads from baselayout.html
function PageDefaults: TMVCEndpointFilter;
begin
  Result :=
    function (const Ctx: TWebContext; const Next: TMVCEndpointFilterNext): IMVCResponse
    begin
      ViewData['app_name'] := '{{:program_name}}';
      ViewData['dmvc_version'] := DMVCFRAMEWORK_VERSION;
      ViewData['current_year'] := YearOf(Now);
      Result := Next();
    end;
end;

// Redirect to ARedirectTo unless the session carries a 'user'.
function RequireLogin(const ARedirectTo: string): TMVCEndpointFilter;
begin
  Result :=
    function (const Ctx: TWebContext; const Next: TMVCEndpointFilterNext): IMVCResponse
    begin
      if Ctx.Session['user'].IsEmpty then
        Result := Redirect(ARedirectTo)
      else
        Result := Next();
    end;
end;

procedure ConfigureRoutes(const ARoot: TMVCRouteGroup<TObject>);
var
  lWeb: TMVCRouteGroup<TObject>;
  lAdmin: TMVCRouteGroup<TObject>;
begin
  ARoot.AsWeb.MapGet('/',
    function: IMVCResponse
    begin
      Result := Redirect('/web');
    end);

  // JSON from the same routes: no .AsWeb, so this is an API route
  ARoot.MapGet('/api/server/info',
    function: IMVCResponse
    var
      lInfo: TJsonObject;
    begin
      lInfo := TJsonObject.Create;
      lInfo.S['application'] := '{{:program_name}}';
      lInfo.S['dmvcVersion'] := DMVCFRAMEWORK_VERSION;
      lInfo.S['serverTime'] := FormatDateTime('yyyy-mm-dd"T"hh:nn:ss', Now);
      lInfo.S['compilerVersion'] := Format('Delphi %.1f', [CompilerVersion], TFormatSettings.Invariant);
      Result := Ok(lInfo);
    end);

  // Pages; MemorySession and PageDefaults are inherited by nested groups.
  lWeb := ARoot.AsWeb.Prefix('/web')
    .Use(MemorySession(30, True, dotEnv.Env('SESSION_COOKIE_SECURE', True)))
    .Use(PageDefaults());

  lWeb.MapGet('',
    function: IMVCResponse
    begin
      ViewData['page_id'] := 'index';
      ViewData['current_date'] := FormatDateTime('dddd, dd mmmm yyyy', Now);
      ViewData['compiler_version'] := {$IF CompilerVersion >= 37}'Delphi 13 Florence'
        {$ELSEIF CompilerVersion >= 36}'Delphi 12 Athens'
        {$ELSEIF CompilerVersion >= 35}'Delphi 11 Alexandria'
        {$ELSEIF CompilerVersion >= 34}'Delphi 10.4 Sydney'
        {$ELSEIF CompilerVersion >= 33}'Delphi 10.3 Rio'
        {$ELSEIF CompilerVersion >= 32}'Delphi 10.2 Tokyo'
        {$ELSE}'Delphi'{$ENDIF};
      Result := RenderView('home/index');
    end);

  lWeb.MapGet('/about',
    function: IMVCResponse
    begin
      ViewData['page_id'] := 'about';
      Result := RenderView('about/index');
    end);

  // HTMX fragments: just the HTML, the page decides where it goes
  lWeb.MapGet('/fragment/clock',
    function: IMVCResponse
    begin
      Result := Html('<time datetime="' + FormatDateTime('yyyy-mm-dd"T"hh:nn:ss', Now) + '">' +
        FormatDateTime('hh:nn:ss', Now) + '</time>');
    end);

  lWeb.MapGet('/fragment/info',
    function: IMVCResponse
    begin
      Result := Html(
        '<dl class="meta-list">' +
        '<dt>Application</dt><dd>{{:program_name}}</dd>' +
        '<dt>DMVCFramework</dt><dd>' + DMVCFRAMEWORK_VERSION + '</dd>' +
        '<dt>Compiler</dt><dd>' + Format('Delphi %.1f', [CompilerVersion], TFormatSettings.Invariant) + '</dd>' +
        '<dt>Server time</dt><dd>' + FormatDateTime('yyyy-mm-dd hh:nn:ss', Now) + '</dd>' +
        '</dl>');
    end);

  lWeb.MapGet('/login',
    function: IMVCResponse
    begin
      ViewData['page_id'] := 'admin';
      Result := RenderView('pages/login');
    end);

  lWeb.MapPost<TWebContext, TLoginForm>('/login',
    function (Ctx: TWebContext; F: TLoginForm): IMVCResponse
    begin
      if (F.Username = 'admin') and (F.Password = 'admin') then
      begin
        Ctx.SessionRegenerateId; // a new session id at login, against session fixation
        Ctx.Session['user'] := F.Username;
        Result := Redirect('/web/admin/');
      end
      else
      begin
        ViewData['page_id'] := 'admin';
        ViewData['error'] := 'Invalid credentials';
        ViewData['login'] := Ctx.Request.ContentFields; // keeps the username; the password is never sent back
        Result := RenderView('pages/login');
        Result.StatusCode := HTTP_STATUS.Unauthorized;
      end;
    end);

  // Login-protected admin subtree (inherits MemorySession and PageDefaults via Prefix).
  lAdmin := lWeb.Prefix('/admin').Use(RequireLogin('/web/login'));

  lAdmin.MapGet<TWebContext>('/',
    function (Ctx: TWebContext): IMVCResponse
    begin
      ViewData['page_id'] := 'admin';
      ViewData['user'] := Ctx.Session['user'];
      Result := RenderView('pages/admin_home');
    end);

  lAdmin.MapGet<TWebContext>('/logout',
    function (Ctx: TWebContext): IMVCResponse
    begin
      Ctx.SessionStop;
      Result := Redirect('/web/login');
    end);
end;

end.
