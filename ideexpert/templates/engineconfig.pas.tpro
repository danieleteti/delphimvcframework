{{include "_license_header.tpro"}}
unit EngineConfigU;

interface

uses
  MVCFramework;

procedure ConfigureEngine(AEngine: TMVCEngine);

implementation

uses
  System.SysUtils,
  System.IOUtils,
{{if controller_main_generate}}
  {{:controller_unit_name}},
{{endif}}
{{if @(program_ssv_any and (not program_minimal_api))}}
  Controllers.APIU,
{{endif}}
{{if jsonrpc_generate}}
  {{:jsonrpc_unit_name}},
  MVCFramework.JSONRPC,
{{endif}}
{{if @(webmodule_middleware_jwt and (not program_minimal_api))}}
  {{:authentication_unit_name}},
  System.DateUtils,
  MVCFramework.JWT,
{{if webmodule_middleware_jwt_asymmetric}}
  MVCFramework.JWT.RSA,
{{endif}}
  MVCFramework.Filters.Authentication,
{{endif}}
{{if program_ssv_templatepro}}
  TemplatePro,
  MVCFramework.View.Renderers.TemplatePro,
{{if webmodule_middleware_activerecord}}
  MVCFramework.View.Renderers.TemplatePro.ActiveRecord,
{{endif}}
{{endif}}
{{if program_ssv_webstencils}}
  MVCFramework.View.Renderers.WebStencils,
{{endif}}
{{if program_ssv_mustache}}
  MVCFramework.View.Renderers.Mustache,
{{endif}}
{{if @(webmodule_middleware_activerecord and (not program_minimal_api))}}
  // ActiveRecord needs the FireDAC driver and the SQL generator of the database in
  // the connection definitions file: SQLite there by default. Another database:
  // replace the SQLite units, e.g. FireDAC.Phys.PG + MVCFramework.SQLGenerators.PostgreSQL.
  FireDAC.Phys.SQLite,
{$IF CompilerVersion >= 34} // 10.4+: SQLite linked into the executable, no sqlite3.dll
  FireDAC.Phys.SQLiteWrapper.Stat,
{$ENDIF}
  MVCFramework.SQLGenerators.Sqlite,
{{endif}}
{{if program_openapi_swagger}}
  MVCFramework.Swagger.Commons,
  MVCFramework.Filters.Swagger,
{{endif}}
{{if program_openapi_native}}
  MVCFramework.OpenAPI3,
  MVCFramework.Filters.OpenAPI,
{{endif}}
{{if @((not program_minimal_api) and (webmodule_middleware_activerecord or webmodule_middleware_session_database))}}
  MVCFramework.Filters.ActiveRecord,
{{endif}}
{{if @(program_minimal_api or mcp_generate or webmodule_middleware_jwt or program_ssv_any or webmodule_middleware_staticfiles or webmodule_middleware_analytics or webmodule_middleware_trace or webmodule_middleware_cors or webmodule_middleware_etag or webmodule_middleware_compression or webmodule_middleware_ratelimit or webmodule_middleware_activerecord or webmodule_middleware_session_memory or webmodule_middleware_session_file or webmodule_middleware_session_database or program_openapi_swagger or program_openapi_native)}}
{{if program_minimal_api}}
  MVCFramework.MinimalAPI,
{{endif}}
  MVCFramework.Filters,
{{endif}}
{{if program_minimal_api_admin_token}}
{{if @(not mcp_generate)}}
  System.Generics.Collections,
{{endif}}
  Routes.RootU,
{{endif}}
{{if mcp_generate}}
  System.Generics.Collections,
  MVCFramework.MCP.Types,
  MVCFramework.MCP.Server,
{{if mcp_bridge}}
  MVCFramework.MCP.Bridge,
{{endif}}
{{endif}}
  MVCFramework.Commons,
  MVCFramework.Logger;

procedure ConfigureEngine(AEngine: TMVCEngine);
{{if @(((not program_minimal_api) and (webmodule_middleware_ratelimit or webmodule_middleware_jwt)) or program_ssv_any or webmodule_middleware_staticfiles or program_openapi_swagger or program_openapi_native)}}
var
{{endif}}
{{if @((not program_minimal_api) and webmodule_middleware_ratelimit)}}
  lRateLimitOptions: TMVCRateLimitOptions;
{{endif}}
{{if @((not program_minimal_api) and webmodule_middleware_jwt)}}
{{if program_ssv_any}}
  lJWTOptions: TMVCJWTCookieAuthenticationOptions;
{{else}}
  lJWTOptions: TMVCJWTAuthenticationOptions;
{{endif}}
{{endif}}
{{if @(program_ssv_any or webmodule_middleware_staticfiles)}}
  lWwwPath: string;
{{endif}}
{{if program_openapi_swagger}}
  lSwaggerInfo: TMVCSwaggerInfo;
{{endif}}
{{if program_openapi_native}}
  lOpenAPIInfo: TMVCOpenAPIInfo;
{{endif}}
{{if @(program_openapi_swagger or program_openapi_native)}}
  lSwaggerUIOptions: TMVCStaticFilesOptions;
{{endif}}
begin
{{if @((not program_minimal_api) and (program_ssv_any or webmodule_middleware_staticfiles))}}

  // Static files path (www folder at same level as executable)
  lWwwPath := TPath.Combine(AppPath, 'www');
{{endif}}
{{if @(program_minimal_api and (program_ssv_any or webmodule_middleware_staticfiles))}}

  // Static files path (www folder at same level as executable)
  lWwwPath := TPath.Combine(AppPath, 'www');
{{endif}}
{{if program_minimal_api_admin_token}}

  // Admin guard: first, before every other filter. The token is the one the wizard wrote in .env
  if dotEnv.Env('api.admin.token', '').Trim.IsEmpty then
    raise Exception.Create('api.admin.token is empty: set it in .env, ' + ADMIN_PATH + ' needs a bearer token');
  AEngine.Use(BearerAuthHTTPFilter(
    StaticBearerTokens([TPair<string, string>.Create('admin', dotEnv.Env('api.admin.token', ''))]),
    ADMIN_PATH));
{{endif}}
{{if mcp_generate}}

  // MCP guards: first, before every middleware and before PublishObject. Every path given to a filter is the full routed one (engine path prefix included)
{{if mcp_auth_jwt}}
  // the JWT filters below authenticate /mcp
{{else}}
  if dotEnv.Env('mcp.auth.token', '').Trim.IsEmpty then
    raise Exception.Create('mcp.auth.token is empty: set it in .env, the /mcp endpoint needs a bearer token');
  AEngine.Use(BearerAuthHTTPFilter(
    StaticBearerTokens([TPair<string, string>.Create('{{:program_name}}', dotEnv.Env('mcp.auth.token', ''))]),
    MCP_ENDPOINT));
{{endif}}
  TMCPServer.Instance.AllowedOrigins := dotEnv.Env('mcp.allowed_origins', '').Split([',']);
  AEngine.Use(AllowedMethodsHTTPFilter([httpPOST, httpDELETE], MCP_ENDPOINT));
{{endif}}

{{if @(not program_minimal_api)}}
  // Controllers
{{if controller_main_generate}}
  AEngine.AddController({{:controller_classname}});
{{endif}}
{{if program_ssv_any}}
  AEngine.AddController(TAPIController);
{{endif}}
{{if mcp_generate}}
  AEngine.AddController(TMCPSessionController); // DELETE /mcp: end of an MCP session
{{endif}}
  // Controllers - END
{{endif}}
{{if program_ssv_templatepro}}

  // Server Side View
  AEngine.SetViewEngine(TMVCTemplateProViewEngine);
  // Server Side View - END
{{endif}}
{{if program_ssv_webstencils}}

  // Server Side View
  AEngine.SetViewEngine(TMVCWebStencilsViewEngine);
  // Server Side View - END
{{endif}}
{{if program_ssv_mustache}}

  // Server Side View
  AEngine.SetViewEngine(TMVCMustacheViewEngine);
  // Server Side View - END
{{endif}}
{{if @(program_minimal_api or program_ssv_any or webmodule_middleware_staticfiles or webmodule_middleware_analytics or webmodule_middleware_trace or webmodule_middleware_cors or webmodule_middleware_etag or webmodule_middleware_compression or webmodule_middleware_ratelimit or webmodule_middleware_activerecord or webmodule_middleware_session_memory or webmodule_middleware_session_file or webmodule_middleware_session_database or program_openapi_swagger or program_openapi_native)}}

  // HTTPFilter chain (engine-wide). Order matters: first = outermost. The filters wrap the whole
  // request: the classic middleware, the routing and the action.
{{if @(program_ssv_any and (not program_minimal_api))}}
  AEngine.Use(RedirectHTTPFilter(['/'], '/web'));
{{endif}}
{{if @(program_ssv_any or webmodule_middleware_staticfiles)}}
  AEngine.Use(FileServerBundle('/static', lWwwPath));
{{endif}}
{{if webmodule_middleware_analytics}}
  AEngine.Use(AnalyticsHTTPFilter());
{{endif}}
{{if webmodule_middleware_trace}}
  AEngine.Use(TraceHTTPFilter());
{{endif}}
{{if webmodule_middleware_cors}}
  AEngine.Use(CORSHTTPFilter('*'));
{{endif}}
{{if webmodule_middleware_etag}}
  AEngine.Use(ETagHTTPFilter());
{{endif}}
{{if webmodule_middleware_compression}}
  AEngine.Use(CompressionHTTPFilter(1024));
{{endif}}
{{if @(program_minimal_api and webmodule_middleware_ratelimit)}}
  AEngine.Use(RateLimitHTTPFilter(60, 60));
{{endif}}
{{if @((not program_minimal_api) and webmodule_middleware_ratelimit)}}
  lRateLimitOptions := TMVCRateLimitOptions.Default;
  lRateLimitOptions.MaxRequests := 10;
  lRateLimitOptions.WindowSeconds := 60;
  // lRateLimitOptions.ExcludedPaths := ['/health'];
{{if mcp_generate}}
  // An MCP client sends several requests per session: raise the limit above before use.
{{endif}}
  lRateLimitOptions.OnExceeded :=
    procedure(const AContext: TWebContext; const AKey: string;
      const ALimit: Integer; const AWindowSeconds: Integer)
    begin
      LogW(Format('Rate limit exceeded for key: %s (Limit: %d requests per %d seconds)',
        [AKey, ALimit, AWindowSeconds]));
    end;
  AEngine.Use(RateLimitHTTPFilter(lRateLimitOptions));
{{endif}}
{{if program_openapi_native}}
  // API documentation: OpenAPI 3 document at {{:program_openapi_url}}, Swagger UI at /swagger.
  // Published only when .env sets dmvc.openapi.enabled=true (off when the key is missing).
  if dotEnv.Env('dmvc.openapi.enabled', False) then
  begin
    lOpenAPIInfo.Title := '{{:program_name}}';
    lOpenAPIInfo.Version := 'v1';
    lOpenAPIInfo.Description := '{{:program_name}} API';
    AEngine.Use(OpenAPIHTTPFilter(AEngine, lOpenAPIInfo, '{{:program_openapi_url}}'));
    lSwaggerUIOptions := TMVCStaticFilesOptions.Default; // redirects /swagger to /swagger/
    lSwaggerUIOptions.Prefix := '/swagger';
    lSwaggerUIOptions.RootFolder := TPath.Combine(TPath.Combine(AppPath, 'www'), 'swagger');
    AEngine.Use(StaticFilesHTTPFilter(lSwaggerUIOptions));
  end;
{{endif}}
{{if program_openapi_swagger}}
  // API documentation: OpenAPI 3 document at {{:program_openapi_url}}, Swagger UI at /swagger.
  // Published only when .env sets dmvc.openapi.enabled=true (off when the key is missing).
  if dotEnv.Env('dmvc.openapi.enabled', False) then
  begin
    lSwaggerInfo.Title := '{{:program_name}}';
    lSwaggerInfo.Version := 'v1';
    lSwaggerInfo.Description := '{{:program_name}} API';
    AEngine.Use(SwaggerHTTPFilter(AEngine, lSwaggerInfo, '{{:program_openapi_url}}',
      JWT_DEFAULT_DESCRIPTION, {{if @(webmodule_middleware_jwt and (not program_ssv_any))}}[sauBearer]{{else}}[]{{endif}}, '', '', '', {{:program_openapi_schemes}}, ssvOpenAPI3));
    lSwaggerUIOptions := TMVCStaticFilesOptions.Default; // redirects /swagger to /swagger/
    lSwaggerUIOptions.Prefix := '/swagger';
    lSwaggerUIOptions.RootFolder := TPath.Combine(TPath.Combine(AppPath, 'www'), 'swagger');
    AEngine.Use(StaticFilesHTTPFilter(lSwaggerUIOptions));
  end;
{{endif}}
{{if @((not program_minimal_api) and webmodule_middleware_activerecord)}}
  AEngine.Use(ActiveRecordHTTPFilter(
    dotEnv.Env('firedac.connection_definition_name', '{{:webmodule_middleware_activerecord_con_def_name}}'),
    dotEnv.Env('firedac.connection_definitions_filename', TPath.Combine(AppPath, '{{:con_def_filename}}'))
  ));
{{endif}}
{{if @((not program_minimal_api) and webmodule_middleware_session_memory)}}
  AEngine.Use(MemorySessionHTTPFilter({{:webmodule_middleware_session_timeout}}, SessionCookieFlags(dotEnv.Env('SESSION_COOKIE_SECURE', True))));
{{endif}}
{{if @((not program_minimal_api) and webmodule_middleware_session_file)}}
  AEngine.Use(FileSessionHTTPFilter({{:webmodule_middleware_session_timeout}}, TPath.Combine(AppPath, 'sessions'), SessionCookieFlags(dotEnv.Env('SESSION_COOKIE_SECURE', True))));
{{endif}}
{{if @((not program_minimal_api) and webmodule_middleware_session_database)}}
  // Database session: requires ActiveRecordHTTPFilter above + dmvc_sessions table
  AEngine.Use(DatabaseSessionHTTPFilter({{:webmodule_middleware_session_timeout}}, SessionCookieFlags(dotEnv.Env('SESSION_COOKIE_SECURE', True))));
{{endif}}
{{endif}}
{{if @((not program_minimal_api) and webmodule_middleware_jwt)}}

{{if program_ssv_any}}
  // JWT in an HTTP-only cookie, for browser clients. POST /login with Basic credentials or the jwtusername / jwtpassword headers.
  lJWTOptions := TMVCJWTCookieAuthenticationOptions.Default;
{{else}}
  // JWT Bearer (Authorization header), for API clients. POST /login with Basic credentials or the jwtusername / jwtpassword headers.
  lJWTOptions := TMVCJWTAuthenticationOptions.Default;
{{endif}}
  lJWTOptions.Handler := {{:authentication_classname}}.Create;
  lJWTOptions.ClaimsSetup := procedure(const JWT: TJWT)
    begin
      JWT.Claims.Issuer := dotEnv.Env('JWT_ISSUER', '{{:program_name}}');
      JWT.Claims.ExpirationTime := Now + OneHour;
      JWT.Claims.NotBefore := Now - OneMinute * 5;
      JWT.Claims.IssuedAt := Now;
      // JWT.CustomClaims['app'] := '{{:program_name}}';
    end;
{{if webmodule_middleware_jwt_asymmetric}}
  // RS256: generate keys with openssl genrsa / openssl rsa -pubout
  lJWTOptions.Signer := TRSAJWTSigner.CreateFromFiles(
    JWT_RS256,
    dotEnv.Env('JWT_PRIVATE_KEY_FILE', TPath.Combine(AppPath, 'jwt-private.pem')),
    dotEnv.Env('JWT_PUBLIC_KEY_FILE', TPath.Combine(AppPath, 'jwt-public.pem'))
  );
{{else}}
  lJWTOptions.Secret := dotEnv.Env('JWT_SECRET'); // no fallback: a missing key must fail, not sign with a public string
{{endif}}
  lJWTOptions.ClaimsToCheck := [TJWTCheckableClaim.ExpirationTime, TJWTCheckableClaim.NotBefore, TJWTCheckableClaim.IssuedAt];
{{if program_ssv_any}}
  // Set JWT_COOKIE_SECURE=false in .env only for local development over HTTP.
  lJWTOptions.Cookie.Secure := dotEnv.Env('JWT_COOKIE_SECURE', True);
  // only these origins may POST /login: a page of another site cannot log the browser in to its own account
  lJWTOptions.LoginAllowedOrigins := dotEnv.Env('LOGIN_ALLOWED_ORIGINS', '').Split([',']);
  if Length(lJWTOptions.LoginAllowedOrigins) = 0 then // an empty list would check no origin
    raise Exception.Create('LOGIN_ALLOWED_ORIGINS is empty: set it in .env, the origins a browser may POST /login from');
  AEngine.Use(JWTCookieAuthenticationBundle(lJWTOptions));
{{else}}
  AEngine.Use(JWTAuthenticationBundle(lJWTOptions));
{{endif}}
{{endif}}

{{if program_ssv_templatepro}}
  // Browser requests get the HTML error view; API clients get RFC 7807 problem+json.
  // Emitted only for TemplatePro server-side views (classic web + minimal web app),
  // the only flavors that ship an 'error' view. ehShowDetails leaks the exception
  // message in DEBUG only.
  AEngine.UseExceptionHandler('error', '{{:program_name}}',
    {$IFDEF DEBUG}[ehShowDetails]{$ELSE}[]{$ENDIF});
{{endif}}
{{if jsonrpc_generate}}

  AEngine.PublishObject(
    function: TObject
    begin
      Result := {{:jsonrpc_classname}}.Create;
    end, '/jsonrpc');
{{endif}}
{{if mcp_generate}}

{{if program_minimal_api}}
  // MCP endpoint: POST /mcp (JSON-RPC), DELETE /mcp (session end)
  AEngine.AddController(TMCPSessionController);
{{else}}
  // MCP endpoint: POST /mcp (JSON-RPC)
{{endif}}
  TMCPServer.Instance.ServerName := '{{:program_name}}';
  TMCPServer.Instance.ServerVersion := '1.0.0';
  AEngine.PublishObject(
    function: TObject
    begin
      Result := TMCPServer.Instance.CreatePublishedEndpoint;
    end, '/mcp');
{{if mcp_bridge}}

  // Prototyping: every REST action above becomes an MCP tool that calls this server over HTTP.
  // HTTP transport only. Replace with hand-written tools before production.
  TMCPServer.Instance.RegisterFromEngine(AEngine,
    'http://localhost:' + dotEnv.Env('dmvc.server.port', '{{:program_default_server_port}}'),
    TMCPBridgeOptions.Create.ExcludeMethods([httpDELETE]));
{{endif}}
{{endif}}
end;

end.
