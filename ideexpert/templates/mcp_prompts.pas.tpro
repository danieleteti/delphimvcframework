{{include "_license_header.tpro"}}
unit Prompts.SampleU;

interface

uses
  JsonDataObjects,
  MVCFramework.MCP.PromptProvider,
  MVCFramework.MCP.Attributes;

type
  // MCP prompts: every [MCPPrompt] method is listed by prompts/list
  TSamplePrompts = class(TMCPPromptProvider)
  public
    [MCPPrompt('summarize', 'Asks for a summary of the given text')]
    [MCPPromptArg('text', 'The text to summarize', TMCPParamPresence.Required)]
    function Summarize(const Arguments: TJDOJsonObject): TMCPPromptResult;
  end;

implementation

uses
  System.SysUtils,
  MVCFramework.MCP.Server;

function TSamplePrompts.Summarize(const Arguments: TJDOJsonObject): TMCPPromptResult;
begin
  Result := TMCPPromptResult.Create('Text summarization',
    [PromptMessage('user', 'Summarize the following text:' + sLineBreak + sLineBreak + Arguments.S['text'])]);
end;

initialization
  TMCPServer.Instance.RegisterPromptProvider(TSamplePrompts);

end.
