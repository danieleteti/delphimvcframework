{{include "_license_header.tpro"}}
unit {{:unit_name}};

interface

uses
  MVCFramework,
  MVCFramework.Commons;

type
  [MVCPath('/api/{{:resource}}')]
  {{:class_name}} = class(TMVCController)
  public
    [MVCPath]
    [MVCHTTPMethod([httpGET])]
    function GetAll: IMVCResponse;
{{if crud}}

    [MVCPath('/($ID:int)')]
    [MVCHTTPMethod([httpGET])]
    function GetByID(ID: Integer): IMVCResponse;

    [MVCPath]
    [MVCHTTPMethod([httpPOST])]
    function CreateItem: IMVCResponse;

    [MVCPath('/($ID:int)')]
    [MVCHTTPMethod([httpPUT])]
    function UpdateItem(ID: Integer): IMVCResponse;

    [MVCPath('/($ID:int)')]
    [MVCHTTPMethod([httpDELETE])]
    function DeleteItem(ID: Integer): IMVCResponse;
{{endif}}
  end;

implementation

uses
  System.SysUtils,
  JsonDataObjects;

function {{:class_name}}.GetAll: IMVCResponse;
begin
  Result := OkResponse(TJsonArray.Create);
end;
{{if crud}}

function {{:class_name}}.GetByID(ID: Integer): IMVCResponse;
begin
  Result := NotFoundResponse;
end;

function {{:class_name}}.CreateItem: IMVCResponse;
var
  lItem: TJsonObject;
begin
  lItem := StrToJSONObject(Context.Request.Body);
  if lItem = nil then
    Exit(BadRequestResponse('The body is not a JSON object'));
  try
    Result := CreatedResponse('/api/{{:resource}}/1');
  finally
    lItem.Free;
  end;
end;

function {{:class_name}}.UpdateItem(ID: Integer): IMVCResponse;
var
  lItem: TJsonObject;
begin
  lItem := StrToJSONObject(Context.Request.Body);
  if lItem = nil then
    Exit(BadRequestResponse('The body is not a JSON object'));
  try
    Result := NoContentResponse;
  finally
    lItem.Free;
  end;
end;

function {{:class_name}}.DeleteItem(ID: Integer): IMVCResponse;
begin
  Result := NoContentResponse;
end;
{{endif}}

end.
