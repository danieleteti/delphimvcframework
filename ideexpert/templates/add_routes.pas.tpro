{{include "_license_header.tpro"}}
unit {{:unit_name}};

interface

uses
  MVCFramework,
  MVCFramework.MinimalAPI,
  {{:model_unit_name}};

procedure {{:procedure_name}}(const AGroup: TMVCRouteGroup<TObject>);

implementation

uses
  System.SysUtils,
  System.Generics.Collections,
  MVCFramework.Commons;

procedure {{:procedure_name}}(const AGroup: TMVCRouteGroup<TObject>);
begin
  AGroup.MapGet('',
    function: IMVCResponse
    begin
      Result := Ok(TObjectList<{{:model_class}}>.Create(True));
{{if openapi_native}}
    end)
    .WithTags('{{:tag}}')
    .WithSummary('List {{:resource}}')
    .Produces<TArray<{{:model_class}}>>;
{{else}}
    end);
{{endif}}
{{if crud}}

  AGroup.MapGet<Integer>('/($id:int)',
    function(ID: Integer): IMVCResponse
    begin
      Result := NotFound;
{{if openapi_native}}
    end)
    .WithTags('{{:tag}}')
    .WithSummary('Get one')
    .Produces<{{:model_class}}>;
{{else}}
    end);
{{endif}}

  // a class argument is bound from the body and validated (422 on failure); the framework frees it
  AGroup.MapPost<{{:model_class}}>('',
    function(Item: {{:model_class}}): IMVCResponse
    begin
      Result := Created('/api/{{:resource}}');
{{if openapi_native}}
    end)
    .WithTags('{{:tag}}')
    .WithSummary('Create');
{{else}}
    end);
{{endif}}

  AGroup.MapPut<Integer, {{:model_class}}>('/($id:int)',
    function(ID: Integer; Item: {{:model_class}}): IMVCResponse
    begin
      Result := NoContent;
{{if openapi_native}}
    end)
    .WithTags('{{:tag}}')
    .WithSummary('Update');
{{else}}
    end);
{{endif}}

  AGroup.MapDelete<Integer>('/($id:int)',
    function(ID: Integer): IMVCResponse
    begin
      Result := NoContent;
{{if openapi_native}}
    end)
    .WithTags('{{:tag}}')
    .WithSummary('Delete');
{{else}}
    end);
{{endif}}
{{endif}}
end;

end.
