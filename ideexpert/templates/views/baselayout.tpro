{{# BASE LAYOUT - DMVCFramework Web Application (Bootstrap 5.3)

  All pages extend this file. In a child template, the first directive must be
  the extends pointing back here (e.g. extends "../baselayout.html"). The
  TemplatePro comment block this notice lives in is stripped at render time, so
  the literal directive name is safe to mention.

  Bootstrap 5.3 ships dark mode out of the box (data-bs-theme="dark"); the
  inline script below restores the saved theme before first paint.

  Available blocks (override in child templates):
    "title"     - Page title (shown in browser tab)
    "body"      - Main page content
    "extra_css" - Additional CSS link or style tags
    "scripts"   - Page-specific script tags (before body close)
    "extra_js"  - Additional JavaScript after scripts

  Available variables (set by the controller):
    app_name         - Application name
    dmvc_version     - DelphiMVCFramework version string
    current_year     - Current year (for copyright)
    page_id          - Current page identifier ("index", "about", ...)
#}}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{block "title"}}{{:app_name}}{{endblock}} &mdash; {{:app_name}}</title>
  <link rel="icon" type="image/x-icon" href="/static/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/static/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/static/apple-touch-icon.png">
  <link rel="manifest" href="/static/site.webmanifest">
  <meta name="theme-color" content="#fbbf24">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/static/css/style.css">
  {{block "extra_css"}}{{endblock}}
  <!--HTMX_SCRIPT-->
  <script>
    // Restore theme preference before first paint (no flash).
    (function() {
      var t = localStorage.getItem('dmvc-theme') || 'dark';
      document.documentElement.setAttribute('data-bs-theme', t);
    })();
  </script>
</head>
<body>

  {{# ---- Icon sprite: one stroke family, referenced with <use href="#i-..."> ---- #}}
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></symbol>
    <symbol id="i-moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"/></symbol>
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></symbol>
    <symbol id="i-sort" viewBox="0 0 24 24"><path d="m6 15 6 6 6-6M6 9l6-6 6 6"/></symbol>
    <symbol id="i-up" viewBox="0 0 24 24"><path d="m6 15 6-6 6 6"/></symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
    <symbol id="i-external" viewBox="0 0 24 24"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></symbol>
  </svg>

  {{# ---- Navigation Bar ---- #}}
  <nav class="navbar navbar-expand-md border-bottom sticky-top app-navbar">
    <div class="container">
      <a class="navbar-brand" href="/web">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
          <rect width="32" height="32" rx="8" fill="#fbbf24"/>
          <path d="M9 9h6.5a7 7 0 0 1 0 14H9z" fill="none" stroke="#1a1a1a" stroke-width="3" stroke-linejoin="round"/>
        </svg>
        {{:app_name}}
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
              data-bs-target="#navbarNav" aria-controls="navbarNav"
              aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav me-auto gap-md-1">
          <li class="nav-item">
            <a class="nav-link {{if page_id|eq,"index"}}active{{endif}}"
               {{if page_id|eq,"index"}}aria-current="page"{{endif}}
               href="/web">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link {{if page_id|eq,"people"}}active{{endif}}"
               {{if page_id|eq,"people"}}aria-current="page"{{endif}}
               href="/web/people">People</a>
          </li>
          <li class="nav-item">
            <a class="nav-link {{if page_id|eq,"about"}}active{{endif}}"
               {{if page_id|eq,"about"}}aria-current="page"{{endif}}
               href="/web/about">About</a>
          </li>
        </ul>
        <div class="d-flex align-items-center gap-2">
          <a class="nav-link text-secondary small d-none d-md-inline" target="_blank" rel="noopener"
             href="https://www.danieleteti.it/delphimvcframework/">Docs <svg class="icon" aria-hidden="true"><use href="#i-external"/></svg></a>
          <button class="btn btn-sm btn-outline-secondary btn-icon" id="themeToggle"
                  type="button" aria-label="Switch theme">
            <svg class="icon" aria-hidden="true"><use href="#i-sun"/></svg>
          </button>
        </div>
      </div>
    </div>
  </nav>

  {{# ---- Main Content (overridden by child templates) ---- #}}
  <main class="container pb-4">
    {{block "body"}}{{endblock}}
  </main>

  {{# ---- Page Footer ---- #}}
  <footer class="border-top mt-5">
    <div class="container d-flex flex-wrap justify-content-between gap-2 py-3 text-secondary small">
      <span>&copy; {{:current_year}} {{:app_name}}</span>
      <span>Built with <a href="https://www.danieleteti.it/delphimvcframework/">DelphiMVCFramework</a>
        <span class="font-monospace">{{:dmvc_version}}</span> &middot;
        <a href="https://leanpub.com/delphimvcframework-2nd-edition" target="_blank" rel="noopener">The official guide</a></span>
    </div>
  </footer>

  {{# ---- Toast Notification Container (Bootstrap 5.3 toast API) ---- #}}
  <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  {{# ---- Page Scripts (overridden by child templates) ---- #}}
  {{block "scripts"}}{{endblock}}
  {{block "extra_js"}}{{endblock}}

  <script>
    // Theme toggle button -> flips data-bs-theme + persists choice.
    (function() {
      var btn = document.getElementById('themeToggle');
      function current() { return document.documentElement.getAttribute('data-bs-theme'); }
      function updateIcon() {
        var dark = current() === 'dark';
        btn.querySelector('use').setAttribute('href', dark ? '#i-sun' : '#i-moon');
        btn.title = dark ? 'Switch to light mode' : 'Switch to dark mode';
        btn.setAttribute('aria-label', btn.title);
      }
      updateIcon();
      btn.addEventListener('click', function() {
        var next = current() === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-bs-theme', next);
        localStorage.setItem('dmvc-theme', next);
        updateIcon();
      });
    })();

    // Show a toast notification. Usage: showToast('Saved!', 'success')
    // Types: 'success', 'danger', 'info' (default), 'warning'.
    function showToast(message, type) {
      var container = document.getElementById('toastContainer');
      var cls = 'text-bg-' + (type || 'info');
      var el = document.createElement('div');
      el.className = 'toast align-items-center border-0 ' + cls;
      el.setAttribute('role', 'alert');
      el.setAttribute('aria-live', 'assertive');
      el.setAttribute('aria-atomic', 'true');
      el.innerHTML =
        '<div class="d-flex">' +
          '<div class="toast-body">' + message + '</div>' +
          '<button type="button" class="btn-close btn-close-white me-2 m-auto"' +
                  ' data-bs-dismiss="toast" aria-label="Close"></button>' +
        '</div>';
      container.appendChild(el);
      var t = new bootstrap.Toast(el, { delay: 3000 });
      t.show();
      el.addEventListener('hidden.bs.toast', function() { el.remove(); });
    }
  </script>

</body>
</html>
