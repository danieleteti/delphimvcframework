{{extends "../baselayout.html"}}
{{import "../lib/forms_bootstrap5.tpro" as f}}

{{block "title"}}Sign in{{endblock}}

{{block "body"}}
<div class="row justify-content-center py-5">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h4 mb-3 text-center">Sign in</h1>
                {{if error}}
                <div class="alert alert-danger">{{:error}}</div>
                {{endif}}
                {{call f.form("/web/login")}}
                {{set userattrs := {"autocomplete": "username", "autofocus": true}}}
                {{set pwdattrs := {"autocomplete": "current-password"}}}
                {{set login := {"username": username}}}
                {{>f.input("username", label="Username", model=login, required=true, attrs=userattrs)}}
                {{>f.input("password", label="Password", type="password", required=true, attrs=pwdattrs)}}
                {{>f.submit("Sign in", class="w-100")}}
                {{endcall}}
                <p class="small text-muted mt-3 mb-0 text-center">Hint: <code>admin</code> / <code>admin</code></p>
            </div>
        </div>
    </div>
</div>
{{endblock}}
