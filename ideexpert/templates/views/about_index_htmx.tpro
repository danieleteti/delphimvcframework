{{# ================================================================
   ABOUT PAGE (with HTMX) - Bootstrap 5.3
   ================================================================
   Extends baselayout.html. The server details are an HTML fragment that
   HTMX loads when the page opens.

   Variables available from the controller:
     app_name, dmvc_version
   ================================================================ #}}
{{extends "../baselayout.html"}}

{{block "title"}}About{{endblock}}

{{block "body"}}

  <header class="page-header">
    <h1>About {{:app_name}}</h1>
    <p class="lead">What this application is made of, and where each piece is documented.</p>
  </header>

  <div class="row g-5">
    <section class="col-lg-7 section" aria-labelledby="stackTitle">
      <h2 class="section-title" id="stackTitle">Built with</h2>
      <dl class="stack">
        <div>
          <dt><a href="https://github.com/danieleteti/delphimvcframework" target="_blank" rel="noopener">DelphiMVCFramework</a>
            <span class="badge brand-mono text-bg-secondary">{{:dmvc_version}}</span></dt>
          <dd>Routing, controllers, middleware, JSON and HTML rendering. The same server
            answers the pages under <code>/web</code> and the JSON API under <code>/api</code>.</dd>
        </div>
        <div>
          <dt><a href="https://github.com/danieleteti/templatepro" target="_blank" rel="noopener">TemplatePro</a></dt>
          <dd>The view engine: layouts with <code>extends</code> and <code>block</code>, loops,
            conditions, filters, macros and includes. Views live in <code>bin/templates</code>.</dd>
        </div>
        <div>
          <dt><a href="https://htmx.org" target="_blank" rel="noopener">HTMX</a></dt>
          <dd>Server-rendered fragments swapped into the page with HTML attributes
            (<code>hx-get</code>, <code>hx-target</code>, <code>hx-trigger</code>), no JavaScript framework.</dd>
        </div>
        <div>
          <dt><a href="https://getbootstrap.com/docs/5.3/" target="_blank" rel="noopener">Bootstrap 5.3</a></dt>
          <dd>Grid, components and the light and dark themes. Brand colours and fonts are in
            <code>bin/www/css/style.css</code>.</dd>
        </div>
      </dl>
    </section>

    <aside class="col-lg-5 section">
      <section class="panel mb-4" aria-labelledby="serverTitle">
        <h2 class="panel-title" id="serverTitle"><span class="live-dot" aria-hidden="true"></span>Server</h2>
        <div hx-get="/web/fragment/info" hx-trigger="load" hx-swap="innerHTML" aria-live="polite">
          <p class="text-secondary mb-0"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading server details</p>
        </div>
      </section>
      <section class="panel mb-4" aria-labelledby="bookTitle">
        <h2 class="panel-title" id="bookTitle">Learn DelphiMVCFramework</h2>
        <p class="text-secondary">The official guide, second edition: from the first controller to
          views, security and deployment.</p>
        <a href="https://leanpub.com/delphimvcframework-2nd-edition" target="_blank" rel="noopener" class="btn btn-primary">
          Get the book on Leanpub <svg class="icon ms-1" aria-hidden="true"><use href="#i-external"/></svg>
        </a>
      </section>
      <section class="panel" aria-labelledby="apiTitle">
        <h2 class="panel-title" id="apiTitle">JSON API</h2>
        <p class="text-secondary">The same data as JSON, from <code>Controllers.APIU</code>.</p>
        <a href="/api/server/info" target="_blank" class="btn btn-outline-primary">
          Open /api/server/info <svg class="icon ms-1" aria-hidden="true"><use href="#i-external"/></svg>
        </a>
      </section>
    </aside>
  </div>

{{endblock}}
