{{# ================================================================
   HOME PAGE (without HTMX) - Bootstrap 5.3
   ================================================================
   Extends baselayout.html. Uses plain fetch() for server interaction.

   Variables available from the controller:
     app_name, dmvc_version, compiler_version, current_date
   ================================================================ #}}
{{extends "../baselayout.html"}}

{{block "title"}}Home{{endblock}}

{{block "body"}}

  <header class="page-header">
    <div class="row g-4 align-items-end">
      <div class="col-lg-7">
        <h1>{{:app_name}} is running</h1>
        <p class="lead">A DelphiMVCFramework web application: controllers render TemplatePro
          views on the server, and small scripts fetch server-rendered fragments into the page.</p>
        <div class="page-actions">
          <a class="btn btn-primary" href="/web/people">
            Open the People table <svg class="icon ms-1" aria-hidden="true"><use href="#i-arrow"/></svg>
          </a>
          <a class="btn btn-outline-secondary" href="/api/server/info" target="_blank">JSON API</a>
        </div>
      </div>
      <div class="col-lg-5">
        <section class="panel" aria-labelledby="serverTitle">
          <h2 class="panel-title" id="serverTitle"><span class="live-dot" aria-hidden="true"></span>Server</h2>
          <dl class="meta-list">
            <dt>Time</dt>
            <dd id="serverClock">--:--:--</dd>
            <dt>Date</dt>
            <dd>{{:current_date}}</dd>
            <dt>DMVCFramework</dt>
            <dd>{{:dmvc_version}}</dd>
            <dt>Compiler</dt>
            <dd>{{:compiler_version}}</dd>
          </dl>
        </section>
      </div>
    </div>
  </header>

  <div class="row g-5">
    <section class="col-lg-7 section" aria-labelledby="startTitle">
      <h2 class="section-title" id="startTitle">Start here</h2>
      <ol class="steps">
        <li>
          <strong>Change this page</strong>
          <p>Edit <code>bin/templates/home/index.html</code> and reload: views are read from disk,
             no recompile needed.</p>
        </li>
        <li>
          <strong>Render your own data</strong>
          <p>The People page renders a list of objects with <code>&#123;&#123;for&#125;&#125;</code> and sorts and
             filters it in the controller. Copy it for your first real page.</p>
        </li>
        <li>
          <strong>Add a page</strong>
          <p>Add an action to <code>{{:controller_unit_name}}</code> that calls <code>RenderView('folder/name')</code>,
             and a template that extends <code>baselayout.html</code>.</p>
        </li>
        <li>
          <strong>Share the layout</strong>
          <p>Navigation, footer and theme live in <code>baselayout.html</code>; page styles in
             <code>bin/www/css/style.css</code>.</p>
        </li>
      </ol>
    </section>

    <section class="col-lg-5 section" aria-labelledby="tryTitle">
      <h2 class="section-title" id="tryTitle">Try a server fragment</h2>
      <div class="panel">
        <p class="text-secondary">The button asks the server for an HTML fragment and puts it
          below. The server time above is the same idea, fetched every 2 seconds.</p>
        <button id="btnLoadInfo" type="button" class="btn btn-outline-primary">Load server info</button>
        <div id="infoResult" class="mt-3 small" aria-live="polite"></div>
        <p class="small text-secondary mb-0 mt-3">
          <code>fetch()</code> &middot; see <code>{{:controller_unit_name}}.GetInfoFragment</code>
        </p>
      </div>
    </section>
  </div>

{{endblock}}

{{block "scripts"}}
<script>
  // Fetch a server-rendered HTML fragment and put it inside a target element.
  function loadFragment(url, target) {
    return fetch(url)
      .then(function(response) {
        if (!response.ok) throw new Error('HTTP ' + response.status);
        return response.text();
      })
      .then(function(html) { target.innerHTML = html; });
  }

  document.getElementById('btnLoadInfo').addEventListener('click', function() {
    var btn = this, label = btn.textContent;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading';
    loadFragment('/web/fragment/info', document.getElementById('infoResult'))
      .then(function() { showToast('Server info loaded', 'success'); })
      .catch(function(err) { showToast('Could not load server info: ' + err.message, 'danger'); })
      .finally(function() { btn.disabled = false; btn.textContent = label; });
  });

  var clock = document.getElementById('serverClock');
  function tick() { loadFragment('/web/fragment/clock', clock).catch(function() {}); }
  tick();
  setInterval(tick, 2000);
</script>
{{endblock}}
