{ Saves a document in DMVC_SWAGGER_DUMP_DIR, when set, for the external validators }
procedure Dump(const AFileName, AContent: string);
var
  lDir: string;
begin
  lDir := GetEnvironmentVariable('DMVC_SWAGGER_DUMP_DIR');
  if lDir <> '' then
    TFile.WriteAllText(TPath.Combine(lDir, AFileName), AContent, TEncoding.UTF8);
end;

