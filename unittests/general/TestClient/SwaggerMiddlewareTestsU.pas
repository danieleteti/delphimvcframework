unit SwaggerMiddlewareTestsU;

// Documents generated by TMVCSwaggerMiddleware (and the Swagger() HTTPFilter)
// fetched from an in-process server: Swagger 2.0 by default, OpenAPI 3 when
// the spec version is selected. TNativeOpenAPITests covers the native
// emitter (OpenAPI() filter) on Minimal API routes and controllers.
//
// Set the DMVC_SWAGGER_DUMP_DIR environment variable to also save the
// documents (swagger2.json, openapi3.json) there, e.g. to run them through an
// external OpenAPI validator.

interface

uses
  DUnitX.TestFramework,
  System.SysUtils,
  System.Generics.Collections,
  System.Net.HttpClient,
  JsonDataObjects,
  MVCFramework,
  MVCFramework.Commons,
  MVCFramework.Swagger.Commons,
  MVCFramework.Serializer.Commons,
  MVCFramework.Nullables,
  MVCFramework.Server.Intf;

const
  SWAGGER_TEST_PORT = 8896;
  NATIVE_TEST_PORT = 8897;
  CASE_TEST_PORT = 8898;
  SWAGGER_TEST_USER = 'swaguser';

type
  TSwagTestPerson = class
  private
    fID: Integer;
    fName: string;
    fNickName: string;
  public
    [MVCSwagJSONSchemaField(stInteger, 'id', 'Person identifier', False)]
    property ID: Integer read fID write fID;
    [MVCSwagJSONSchemaField(stString, 'name', 'Person name', True, False, 1, 100)]
    property Name: string read fName write fName;
    [MVCSwagJSONSchemaField(stString, 'nickname', 'Optional nickname', False, True)]
    property NickName: string read fNickName write fNickName;
  end;

  [MVCPath('/api/people')]
  [MVCSWAGDefaultModel(TSwagTestPerson, 'Person', 'People')]
  [MVCSWAGDefaultSummaryTags('People')]
  TSwagTestPeopleController = class(TMVCController)
  public
    [MVCPath]
    [MVCHTTPMethod([httpGET])]
    [MVCSwagSummary(TSwaggerConst.USE_DEFAULT_SUMMARY_TAGS, 'List people', 'getPeople')]
    [MVCSwagResponses(200, 'Success', SWAGUseDefaultControllerModel, True)]
    procedure GetPeople;

    [MVCPath('/($ID)')]
    [MVCHTTPMethod([httpGET])]
    [MVCSwagSummary(TSwaggerConst.USE_DEFAULT_SUMMARY_TAGS, 'Get a person', 'getPerson')]
    [MVCSwagResponses(200, 'Success', SWAGUseDefaultControllerModel)]
    [MVCSwagResponses(404, 'Not found')]
    procedure GetPerson(ID: Integer);

    [MVCPath]
    [MVCHTTPMethod([httpPOST])]
    [MVCSwagSummary(TSwaggerConst.USE_DEFAULT_SUMMARY_TAGS, 'Create a person', 'createPerson')]
    [MVCSwagParam(plBody, 'person', 'The person to create', SWAGUseDefaultControllerModel)]
    [MVCSwagResponses(201, 'Created')]
    [MVCRequiresAuthentication]
    procedure CreatePerson;

    [MVCPath('/($ID)')]
    [MVCHTTPMethod([httpDELETE])]
    [MVCSwagSummary(TSwaggerConst.USE_DEFAULT_SUMMARY_TAGS, 'Delete a person', 'deletePerson')]
    [MVCSwagResponses(204, 'Deleted')]
    [MVCSwagAuthentication(atBasic)]
    procedure DeletePerson(ID: Integer);
  end;

  // a path with a converter: the document must show {ID}, a string
  [MVCPath('/api/codes')]
  TSwagTestSqidsController = class(TMVCController)
  public
    [MVCPath('/($ID:sqids)')]
    [MVCHTTPMethod([httpGET])]
    [MVCSwagSummary('Codes', 'Get by sqid', 'getByCode')]
    procedure GetByCode(ID: Integer);
    // the action parameter is spelled differently from the placeholder
    [MVCPath('/byid/($ID)')]
    [MVCHTTPMethod([httpGET])]
    [MVCSwagSummary('Codes', 'Get by id', 'getByID')]
    procedure GetByID(id: Integer);
  end;

  // no action parameter: the path parameter comes from MVCSwagParam only,
  // spelled "id" while the placeholder is "($ID:sqids)"
  [MVCPath('/api/raw')]
  TSwagTestCaseController = class(TMVCController)
  public
    [MVCPath('/($ID:sqids)')]
    [MVCHTTPMethod([httpGET])]
    [MVCSwagSummary('Raw', 'Get by sqid', 'getRaw')]
    [MVCSwagParam(plPath, 'id', 'The sqid', ptInteger)]
    procedure GetRaw;
  end;

