unit ActiveRecordAssignTestsU;

interface

uses
  DUnitX.TestFramework,
  System.SysUtils, System.Classes,
  FireDAC.Comp.Client, FireDAC.Stan.Intf, FireDAC.Stan.Option, FireDAC.DApt,
  FireDAC.Phys.SQLite, FireDAC.Phys.SQLiteWrapper.Stat,
  MVCFramework.ActiveRecord, MVCFramework.SQLGenerators.Sqlite,
  MVCFramework.Nullables;

type
  [MVCTable('assign_people')]
  TAssignPerson = class(TMVCActiveRecord)
  private
    [MVCTableField('id', [foPrimaryKey, foAutoGenerated])]
    fID: NullableInt64;
    [MVCTableField('name')]
    fName: string;
    [MVCTableField('title')]
    fTitle: NullableString;
    [MVCTableField('code', [foReadOnly])]
    fCode: string;
    [MVCTableField('notes', [foDoNotUpdate])]
    fNotes: string;
    [MVCTableField('objversion', [foVersion])]
    fObjVersion: Integer;
    [MVCTableField('photo')]
    fPhoto: TMemoryStream;
    fTransient: string; // not mapped: Assign must leave it alone
  public
    constructor Create; override;
    destructor Destroy; override;
    property ID: NullableInt64 read fID write fID;
    property Name: string read fName write fName;
    property Title: NullableString read fTitle write fTitle;
    property Code: string read fCode write fCode;
    property Notes: string read fNotes write fNotes;
    property ObjVersion: Integer read fObjVersion write fObjVersion;
    property Photo: TMemoryStream read fPhoto;
    property Transient: string read fTransient write fTransient;
  end;

  [MVCTable('assign_people')] // MVCTable is not inherited
  TAssignPersonChild = class(TAssignPerson);

  [MVCTable('assign_nostream')]
  TAssignNoStream = class(TMVCActiveRecord)
  private
    [MVCTableField('id', [foPrimaryKey])]
    fID: Integer;
    [MVCTableField('photo')]
    fPhoto: TMemoryStream; // never created: Assign must refuse to write into it
  public
    property ID: Integer read fID write fID;
    property Photo: TMemoryStream read fPhoto write fPhoto;
  end;

  [MVCTable('assign_composite')]
  TAssignComposite = class(TMVCActiveRecord)
  private
    [MVCTableField('doc_code', [foPrimaryKey])]
    fDocCode: string;
    [MVCTableField('line_no', [foPrimaryKey])]
    fLineNo: Integer;
    [MVCTableField('qty')]
    fQty: Integer;
  public
    property DocCode: string read fDocCode write fDocCode;
    property LineNo: Integer read fLineNo write fLineNo;
    property Qty: Integer read fQty write fQty;
  end;

  [MVCTable('assign_tracked')]
  [MVCChangeTracking]
  TAssignTracked = class(TMVCActiveRecord)
  private
    [MVCTableField('id', [foPrimaryKey, foAutoGenerated])]
    fID: Int64;
    [MVCTableField('name')]
    fName: string;
    [MVCTableField('title')]
    fTitle: NullableString;
  public
    property ID: Int64 read fID write fID;
    property Name: string read fName write fName;
    property Title: NullableString read fTitle write fTitle;
  end;

  [TestFixture]
  TTestActiveRecordAssign = class
  public
    [Test] procedure TestCopiesPrimaryKey;
    [Test] procedure TestCopiesCompositePrimaryKey;
    [Test] procedure TestCopiesNullOverValue;
    [Test] procedure TestCopiesValueOverNull;
    [Test] procedure TestCopiesReadOnlyAndDoNotUpdateFields;
    [Test] procedure TestCopiesVersionField;
    [Test] procedure TestDoesNotCopyUnmappedFields;
    [Test] procedure TestCopiesStreamByContent;
    [Test] procedure TestEmptySourceStreamEmptiesTarget;
    [Test] procedure TestNilTargetStreamRaises;
    [Test] procedure TestAssignSelfIsNoOp;
    [Test] procedure TestAssignNilRaises;
    [Test] procedure TestAssignOtherClassRaises;
    [Test] procedure TestAssignFromDescendant;
    [Test] procedure TestAssignFromAncestorRaises;
  end;

  [TestFixture]
  TTestActiveRecordAssignDB = class
  strict private
    FConn: TFDConnection;
    function InsertTracked(const AName, ATitle: string): Int64;
  public
    [SetUp] procedure SetUp;
    [TearDown] procedure TearDown;
    [Test] procedure TestUpdateFromBodyKeepsUrlKey;
    [Test] procedure TestAssignCountsAsChangeOnTrackedEntity;
  end;

implementation

{ TAssignPerson }

constructor TAssignPerson.Create;
begin
  inherited Create;
  fPhoto := TMemoryStream.Create;
end;

destructor TAssignPerson.Destroy;
begin
  fPhoto.Free;
  inherited;
end;

procedure WriteText(const AStream: TStream; const AText: string);
var
  lBytes: TBytes;
begin
  lBytes := TEncoding.UTF8.GetBytes(AText);
  AStream.Size := 0;
  if Length(lBytes) > 0 then
    AStream.WriteBuffer(lBytes[0], Length(lBytes));
  AStream.Position := 0;
end;

function ReadText(const AStream: TStream): string;
var
  lBytes: TBytes;
begin
  SetLength(lBytes, AStream.Size);
  AStream.Position := 0;
  if AStream.Size > 0 then
    AStream.ReadBuffer(lBytes[0], AStream.Size);
  AStream.Position := 0;
  Result := TEncoding.UTF8.GetString(lBytes);
end;

{ TTestActiveRecordAssign }

procedure TTestActiveRecordAssign.TestCopiesPrimaryKey;
var
  lSource, lTarget: TAssignPerson;
begin
  lTarget := nil;
  lSource := TAssignPerson.Create;
  try
    lTarget := TAssignPerson.Create;
    lSource.ID := 42;
    lTarget.ID := 7;
    lTarget.Assign(lSource);
    Assert.IsTrue(lTarget.ID.HasValue);
    Assert.AreEqual<Int64>(42, lTarget.ID.Value, 'The primary key is part of the copy');
  finally
    lTarget.Free;
    lSource.Free;
  end;
end;

procedure TTestActiveRecordAssign.TestCopiesCompositePrimaryKey;
var
  lSource, lTarget: TAssignComposite;
begin
  lTarget := nil;
  lSource := TAssignComposite.Create;
  try
    lTarget := TAssignComposite.Create;
    lSource.DocCode := 'INV-1';
    lSource.LineNo := 3;
    lSource.Qty := 10;
    lTarget.Assign(lSource);
    Assert.AreEqual('INV-1', lTarget.DocCode);
    Assert.AreEqual(3, lTarget.LineNo, 'Every PK column is copied, not only the first');
    Assert.AreEqual(10, lTarget.Qty);
  finally
    lTarget.Free;
    lSource.Free;
  end;
end;

procedure TTestActiveRecordAssign.TestCopiesNullOverValue;
var
  lSource, lTarget: TAssignPerson;
begin
  lTarget := nil;
  lSource := TAssignPerson.Create;
  try
    lTarget := TAssignPerson.Create;
    lTarget.Title := 'Dr.';
    lSource.Title.Clear;
    lTarget.Assign(lSource);
    Assert.IsFalse(lTarget.Title.HasValue, 'A null in the source becomes a null in the target');
  finally
    lTarget.Free;
    lSource.Free;
  end;
end;

procedure TTestActiveRecordAssign.TestCopiesValueOverNull;
var
  lSource, lTarget: TAssignPerson;
begin
  lTarget := nil;
  lSource := TAssignPerson.Create;
  try
    lTarget := TAssignPerson.Create;
    lTarget.Title.Clear;
    lSource.Title := 'Prof.';
    lSource.Name := 'Ada';
    lTarget.Assign(lSource);
    Assert.IsTrue(lTarget.Title.HasValue);
    Assert.AreEqual('Prof.', lTarget.Title.Value);
    Assert.AreEqual('Ada', lTarget.Name);
  finally
    lTarget.Free;
    lSource.Free;
  end;
end;

procedure TTestActiveRecordAssign.TestCopiesReadOnlyAndDoNotUpdateFields;
var
  lSource, lTarget: TAssignPerson;
begin
  lTarget := nil;
  lSource := TAssignPerson.Create;
  try
    lTarget := TAssignPerson.Create;
    lSource.Code := 'RO-1';
    lSource.Notes := 'not updatable';
    lTarget.Assign(lSource);
    Assert.AreEqual('RO-1', lTarget.Code, 'foReadOnly fields are copied');
    Assert.AreEqual('not updatable', lTarget.Notes, 'foDoNotUpdate fields are copied');
  finally
    lTarget.Free;
    lSource.Free;
  end;
end;

procedure TTestActiveRecordAssign.TestCopiesVersionField;
var
  lSource, lTarget: TAssignPerson;
begin
  lTarget := nil;
  lSource := TAssignPerson.Create;
  try
    lTarget := TAssignPerson.Create;
    lSource.ObjVersion := 5;
    lTarget.ObjVersion := 9;
    lTarget.Assign(lSource);
    Assert.AreEqual(5, lTarget.ObjVersion, 'foVersion is copied');
  finally
    lTarget.Free;
    lSource.Free;
  end;
end;

procedure TTestActiveRecordAssign.TestDoesNotCopyUnmappedFields;
var
  lSource, lTarget: TAssignPerson;
begin
  lTarget := nil;
  lSource := TAssignPerson.Create;
  try
    lTarget := TAssignPerson.Create;
    lSource.Transient := 'source';
    lTarget.Transient := 'target';
    lTarget.Assign(lSource);
    Assert.AreEqual('target', lTarget.Transient, 'Fields without MVCTableField are not copied');
  finally
    lTarget.Free;
    lSource.Free;
  end;
end;

procedure TTestActiveRecordAssign.TestCopiesStreamByContent;
var
  lSource, lTarget: TAssignPerson;
  lTargetStream: TStream;
begin
  lTarget := nil;
  lSource := TAssignPerson.Create;
  try
    lTarget := TAssignPerson.Create;
    lTargetStream := lTarget.Photo;
    WriteText(lSource.Photo, 'source bytes');
    WriteText(lTarget.Photo, 'old target bytes, longer than the source');
    lSource.Photo.Position := 4;
    lTarget.Assign(lSource);
    Assert.AreSame(lTargetStream, lTarget.Photo, 'The target keeps its own stream instance');
    Assert.AreNotSame(lSource.Photo, lTarget.Photo, 'The reference is never shared');
    Assert.AreEqual('source bytes', ReadText(lTarget.Photo), 'The whole content is copied, the old content is gone');
    Assert.AreEqual<Int64>(0, lTarget.Photo.Position);
    Assert.AreEqual<Int64>(0, lSource.Photo.Position);
    WriteText(lSource.Photo, 'changed later');
    Assert.AreEqual('source bytes', ReadText(lTarget.Photo), 'The copy is independent from the source');
  finally
    lTarget.Free;
    lSource.Free;
  end;
end;

procedure TTestActiveRecordAssign.TestEmptySourceStreamEmptiesTarget;
var
  lSource, lTarget: TAssignPerson;
begin
  lTarget := nil;
  lSource := TAssignPerson.Create;
  try
    lTarget := TAssignPerson.Create;
    WriteText(lTarget.Photo, 'something');
    lTarget.Assign(lSource);
    Assert.AreEqual<Int64>(0, lTarget.Photo.Size);
  finally
    lTarget.Free;
    lSource.Free;
  end;
end;

procedure TTestActiveRecordAssign.TestNilTargetStreamRaises;
var
  lSource, lTarget: TAssignNoStream;
begin
  lTarget := nil;
  lSource := TAssignNoStream.Create;
  try
    lTarget := TAssignNoStream.Create;
    lSource.Photo := TMemoryStream.Create;
    try
      Assert.WillRaise(
        procedure
        begin
          lTarget.Assign(lSource);
        end, EMVCActiveRecord);
    finally
      lSource.Photo.Free;
      lSource.Photo := nil;
    end;
  finally
    lTarget.Free;
    lSource.Free;
  end;
end;

procedure TTestActiveRecordAssign.TestAssignSelfIsNoOp;
var
  lPerson: TAssignPerson;
begin
  lPerson := TAssignPerson.Create;
  try
    lPerson.Name := 'Ada';
    WriteText(lPerson.Photo, 'keep me');
    lPerson.Assign(lPerson);
    Assert.AreEqual('Ada', lPerson.Name);
    Assert.AreEqual('keep me', ReadText(lPerson.Photo), 'Self-assign must not truncate the stream');
  finally
    lPerson.Free;
  end;
end;

procedure TTestActiveRecordAssign.TestAssignNilRaises;
var
  lPerson: TAssignPerson;
begin
  lPerson := TAssignPerson.Create;
  try
    Assert.WillRaise(
      procedure
      begin
        lPerson.Assign(nil);
      end, EMVCActiveRecord);
  finally
    lPerson.Free;
  end;
end;

