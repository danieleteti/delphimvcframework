{ TTestActiveRecordAssignDB }

procedure TTestActiveRecordAssignDB.SetUp;
begin
  FConn := TFDConnection.Create(nil);
  FConn.DriverName := 'SQLite';
  FConn.Params.Values['Database'] := ':memory:';
  FConn.Connected := True;
  FConn.ExecSQL(
    'CREATE TABLE assign_tracked (id INTEGER PRIMARY KEY AUTOINCREMENT, ' +
    'name TEXT, title TEXT)');
  ActiveRecordConnectionsRegistry.AddDefaultConnection(FConn);
end;

procedure TTestActiveRecordAssignDB.TearDown;
begin
  ActiveRecordConnectionsRegistry.RemoveDefaultConnection;
  FConn.Free;
end;

function TTestActiveRecordAssignDB.InsertTracked(const AName, ATitle: string): Int64;
var
  lRow: TAssignTracked;
begin
  lRow := TAssignTracked.Create;
  try
    lRow.Name := AName;
    lRow.Title := ATitle;
    lRow.Insert;
    Result := lRow.ID;
  finally
    lRow.Free;
  end;
end;

procedure TTestActiveRecordAssignDB.TestUpdateFromBodyKeepsUrlKey;
var
  lUrlID, lOtherID: Int64;
  lBody, lExisting, lReloaded: TAssignTracked;
begin
  lUrlID := InsertTracked('Ada', 'Countess');
  lOtherID := InsertTracked('Grace', 'Admiral');

  // what a PUT /people/<lUrlID> with a hostile "id" in the body deserializes to
  lBody := TAssignTracked.Create;
  try
    lBody.ID := lOtherID;
    lBody.Name := 'Ada Lovelace';
    lBody.Title.Clear;

    lExisting := TMVCActiveRecord.GetByPK<TAssignTracked>(lUrlID);
    try
      lExisting.Assign(lBody);
      Assert.AreEqual<Int64>(lOtherID, lExisting.ID, 'Assign copied the body key, as documented');
      lExisting.ID := lUrlID; // the pattern documented on Assign
      lExisting.Update;
    finally
      lExisting.Free;
    end;
  finally
    lBody.Free;
  end;

  lReloaded := TMVCActiveRecord.GetByPK<TAssignTracked>(lUrlID);
  try
    Assert.AreEqual('Ada Lovelace', lReloaded.Name);
    Assert.IsFalse(lReloaded.Title.HasValue, 'The null from the body reached the database');
  finally
    lReloaded.Free;
  end;
  lReloaded := TMVCActiveRecord.GetByPK<TAssignTracked>(lOtherID);
  try
    Assert.AreEqual('Grace', lReloaded.Name, 'The row named in the body was not touched');
    Assert.AreEqual('Admiral', lReloaded.Title.Value);
  finally
    lReloaded.Free;
  end;
end;

procedure TTestActiveRecordAssignDB.TestAssignCountsAsChangeOnTrackedEntity;
var
  lID: Int64;
  lSource, lExisting: TAssignTracked;
  lChanged: TArray<string>;
begin
  lID := InsertTracked('Ada', 'Countess');
  lSource := TAssignTracked.Create;
  try
    lSource.ID := lID;
    lSource.Name := 'Ada';
    lSource.Title := 'Mathematician';
    lExisting := TMVCActiveRecord.GetByPK<TAssignTracked>(lID);
    try
      Assert.IsFalse(lExisting.IsChanged);
      lExisting.Assign(lSource);
      Assert.IsTrue(lExisting.IsChanged, 'Assign is an edit: the snapshot taken at load is kept');
      lChanged := lExisting.GetChangedFields;
      Assert.AreEqual<NativeInt>(1, Length(lChanged), 'Only the field whose value differs is changed');
      Assert.AreEqual('title', lChanged[0].ToLower);
    finally
      lExisting.Free;
    end;
  finally
    lSource.Free;
  end;
end;

initialization
  TDUnitX.RegisterTestFixture(TTestActiveRecordAssign);
  TDUnitX.RegisterTestFixture(TTestActiveRecordAssignDB);

end.
