{
  "openapi":"3.2.1",
  "$self":"https:\/\/api.example.com\/api\/v1\/openapi.json",
  "info":
  {
    "title":"Sample API",
    "summary":"Employee management API.",
    "description":"Sample API documented with OpenAPI 3 using SwagDoc.",
    "termsOfService":"http:\/\/www.apache.org\/licenses\/LICENSE-2.0.txt",
    "contact":
    {
      "name":"Marcelo Jaloto",
      "email":"marcelojaloto@gmail.com",
      "url":"https:\/\/github.com\/marcelojaloto\/SwagDoc"
    }
,
    "license":
    {
      "name":"Apache License - Version 2.0, January 2004",
      "identifier":"Apache-2.0"
    }
,
    "version":"v1",
    "x-logo":
    {
      "url":"https:\/\/example.com\/logo.png",
      "altText":"Sample API"
    }
  }
,
  "servers":
  [
        {
      "url":"https:\/\/{environment}.example.com\/api\/{version}",
      "description":"Cloud server",
      "name":"cloud",
      "variables":
      {
        "environment":
        {
          "enum":
          [
            "api",
            "staging",
            "sandbox"
          ]
,
          "default":"api",
          "description":"The environment of the API."
        }
,
        "version":
        {
          "default":"v1",
          "description":"The version of the API."
        }
      }
    }
,
    
    {
      "url":"http:\/\/localhost:8080\/api\/v1",
      "description":"Local development server",
      "name":"local"
    }
  ]
,
  "tags":
  [
        {
      "name":"Employees",
      "summary":"Employees",
      "description":"Operations on the employees of the company.",
      "kind":"nav"
    }
,
    
    {
      "name":"Employee documents",
      "summary":"Documents",
      "description":"Documents attached to an employee.",
      "parent":"Employees",
      "kind":"nav"
    }
,
    
    {
      "name":"Notifications",
      "summary":"Notifications",
      "description":"Requests sent by the API to the client applications.",
      "kind":"nav"
    }
,
    
    {
      "name":"Health",
      "summary":"Health",
      "kind":"nav"
    }
  ]
,
  "paths":
  {
    "\/health":
    {
      "$ref":"#\/components\/pathItems\/health"
    }
,
    "\/employees":
    {
      "summary":"Employees collection",
      "get":
      {
        "tags":
        [
          "Employees"
        ]
,
        "summary":"Lists the employees",
        "description":"Returns the employees as a JSON array, as JSON Lines or as a CSV file.",
        "operationId":"listEmployees",
        "parameters":
        [
                    {
            "$ref":"#\/components\/parameters\/limit"
          }
,
          
          {
            "name":"department",
            "in":"query",
            "description":"Returns only the employees of the department.",
            "examples":
            {
              "sales":
              {
                "summary":"Sales department",
                "dataValue":"sales"
              }
,
              "engineering":
              {
                "summary":"Engineering department",
                "dataValue":"engineering"
              }
            }
,
            "schema":
            {
              "type":"string"
            }
          }
,
          
          {
            "name":"preferredView",
            "in":"cookie",
            "description":"The layout remembered by the web client. Use the Accept header instead.",
            "deprecated":true,
            "schema":
            {
              "type":"string"
            }
          }
        ]
,
        "responses":
        {
          "200":
          {
            "description":"Successfully returns data",
            "headers":
            {
              "X-Rate-Limit-Remaining":
              {
                "$ref":"#\/components\/headers\/X-Rate-Limit-Remaining"
              }
            }
,
            "content":
            {
              "application\/json":
              {
                "schema":
                {
                  "type":"array",
                  "items":
                  {
                    "$ref":"#\/components\/schemas\/employeeResponse"
                  }
                }
,
                "examples":
                {
                  "employeeList":
                  {
                    "$ref":"#\/components\/examples\/employeeList"
                  }
                }
              }
,
              "application\/jsonl":
              {
                "itemSchema":
                {
                  "$ref":"#\/components\/schemas\/employeeResponse"
                }
              }
,
              "text\/csv":
              {
                "schema":
                {
                  "type":"string"
                }
,
                "examples":
                {
                  "employeeListCsv":
                  {
                    "$ref":"#\/components\/examples\/employeeListCsv"
                  }
,
                  "fullExport":
                  {
                    "summary":"Complete export",
                    "externalValue":"https:\/\/example.com\/samples\/employees.csv"
                  }
                }
              }
            }
          }
,
          "default":
          {
            "$ref":"#\/components\/responses\/problem"
          }
        }
,
        "x-rate-limit-tier":"standard"
      }
,
      "post":
      {
        "tags":
        [
          "Employees"
        ]
,
        "summary":"Creates an employee",
        "operationId":"createEmployee",
        "requestBody":
        {
          "$ref":"#\/components\/requestBodies\/employee"
        }
,
        "responses":
        {
          "201":
          {
            "description":"Successfully creates data",
            "headers":
            {
              "Location":
              {
                "description":"The address of the new employee.",
                "required":true,
                "schema":
                {
                  "type":"string",
                  "format":"uri-reference"
                }
              }
            }
,
            "content":
            {
              "application\/json":
              {
                "$ref":"#\/components\/mediaTypes\/employeeJson"
              }
            }
,
            "links":
            {
              "GetEmployeeById":
              {
                "$ref":"#\/components\/links\/GetEmployeeById"
              }
,
              "UpdateEmployee":
              {
                "operationId":"updateEmployee",
                "parameters":
                {
                  "id":"$response.body#\/id"
                }
,
                "description":"The id returned in the response can be used to update the employee."
              }
            }
          }
,
          "400":
          {
            "$ref":"#\/components\/responses\/problem",
            "description":"The employee data is invalid."
          }
        }
,
        "security":
        [
                    {
            "oauth2Auth":
            [
              "employees:write"
            ]
          }
        ]
      }
,
      "x-resource":"employee"
    }
,
    "\/employees\/filter":
    {
      "get":
      {
        "tags":
        [
          "Employees"
        ]
,
        "summary":"Filters the employees",
        "description":"Receives the whole query string as a single form encoded parameter.",
        "operationId":"filterEmployees",
        "parameters":
        [
                    {
            "name":"filter",
            "in":"querystring",
            "description":"The filter criteria.",
            "examples":
            {
              "bySkills":
              {
                "summary":"Engineers who know Delphi and SQL",
                "serializedValue":"department=engineering&skills=delphi,sql"
              }
            }
,
            "content":
            {
              "application\/x-www-form-urlencoded":
              {
                "schema":
                {
                  "type":"object",
                  "properties":
                  {
                    "department":
                    {
                      "type":"string"
                    }
,
                    "skills":
                    {
                      "type":"array",
                      "items":
                      {
                        "type":"string"
                      }
                    }
                  }
                }
,
                "encoding":
                {
                  "skills":
                  {
                    "style":"form",
                    "explode":false
                  }
                }
              }
            }
          }
        ]
,
        "responses":
        {
          "200":
          {
            "description":"Successfully returns data",
            "content":
            {
              "application\/json":
              {
                "schema":
                {
                  "type":"array",
                  "items":
                  {
                    "$ref":"#\/components\/schemas\/employeeResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
,
    "\/employees\/search":
    {
      "query":
      {
        "tags":
        [
          "Employees"
        ]
,
        "summary":"Searches the employees",
        "description":"The QUERY method sends the search criteria in the request body and is safe and idempotent.",
        "operationId":"searchEmployees",
        "requestBody":
        {
          "required":true,
          "content":
          {
            "application\/json":
            {
              "schema":
              {
                "type":"object",
                "properties":
                {
                  "name":
                  {
                    "type":"string"
                  }
,
                  "hiredAfter":
                  {
                    "type":"string",
                    "format":"date"
                  }
                }
              }
            }
          }
        }
,
        "responses":
        {
          "200":
          {
            "description":"Successfully returns data",
            "content":
            {
              "application\/json":
              {
                "schema":
                {
                  "type":"array",
                  "items":
                  {
                    "$ref":"#\/components\/schemas\/employeeResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
,
    "\/employees\/exports":
    {
      "post":
      {
        "tags":
        [
          "Employees"
        ]
,
        "summary":"Exports the employees",
        "description":"Starts the export and calls the callback URL when the file is ready.",
        "operationId":"exportEmployees",
        "requestBody":
        {
          "required":true,
          "content":
          {
            "application\/json":
            {
              "schema":
              {
                "type":"object",
                "properties":
                {
                  "callbackUrl":
                  {
                    "type":"string",
                    "format":"uri"
                  }
                }
,
                "required":
                [
                  "callbackUrl"
                ]
              }
            }
          }
        }
,
        "responses":
        {
          "202":
          {
            "description":"The export was started."
          }
        }
,
        "callbacks":
        {
          "exportCompleted":
          {
            "$ref":"#\/components\/callbacks\/exportCompleted"
          }
        }
      }
    }
,
    "\/employees\/{id}":
    {
      "parameters":
      [
                {
          "$ref":"#\/components\/parameters\/id"
        }
      ]
,
      "get":
      {
        "tags":
        [
          "Employees"
        ]
,
        "summary":"Returns an employee",
        "operationId":"getEmployee",
        "responses":
        {
          "200":
          {
            "description":"Successfully returns data",
            "content":
            {
              "application\/json":
              {
                "$ref":"#\/components\/mediaTypes\/employeeJson"
              }
            }
          }
,
          "404":
          {
            "$ref":"#\/components\/responses\/notFound",
            "summary":"Unknown employee"
          }
        }
      }
,
      "put":
      {
        "tags":
        [
          "Employees"
        ]
,
        "summary":"Updates an employee",
        "operationId":"updateEmployee",
        "requestBody":
        {
          "$ref":"#\/components\/requestBodies\/employee",
          "description":"The new data of the employee."
        }
,
        "responses":
        {
          "200":
          {
            "description":"Successfully updates data",
            "content":
            {
              "application\/json":
              {
                "$ref":"#\/components\/mediaTypes\/employeeJson"
              }
            }
          }
,
          "404":
          {
            "$ref":"#\/components\/responses\/notFound"
          }
        }
,
        "security":
        [
                    {
            "oauth2Auth":
            [
              "employees:write"
            ]
          }
        ]
      }
,
      "delete":
      {
        "tags":
        [
          "Employees"
        ]
,
        "summary":"Deletes an employee",
        "description":"Requires the write scope and the client certificate at the same time.",
        "operationId":"deleteEmployee",
        "responses":
        {
          "204":
          {
            "description":"Successfully deletes data"
          }
,
          "404":
          {
            "$ref":"#\/components\/responses\/notFound"
          }
        }
,
        "security":
        [
                    {
            "oauth2Auth":
            [
              "employees:write"
            ]
,
            "mutualTlsAuth":
            [
                          ]
          }
        ]
      }
    }
,
    "\/employees\/{id}\/documents":
    {
      "parameters":
      [
                {
          "$ref":"#\/components\/parameters\/id"
        }
      ]
,
      "post":
      {
        "tags":
        [
          "Employee documents"
        ]
,
        "summary":"Uploads a document of the employee",
        "operationId":"uploadEmployeeDocument",
        "requestBody":
        {
          "required":true,
          "content":
          {
            "multipart\/form-data":
            {
              "schema":
              {
                "type":"object",
                "properties":
                {
                  "metadata":
                  {
                    "type":"object",
                    "properties":
                    {
                      "title":
                      {
                        "type":"string"
                      }
                    }
                  }
,
                  "file":
                  {
                    "type":"string",
                    "contentMediaType":"application\/pdf"
                  }
                }
,
                "required":
                [
                  "file"
                ]
              }
,
              "encoding":
              {
                "metadata":
                {
                  "contentType":"application\/json"
                }
,
                "file":
                {
                  "contentType":"application\/pdf",
                  "headers":
                  {
                    "X-Document-Checksum":
                    {
                      "description":"The SHA-256 checksum of the file.",
                      "schema":
                      {
                        "type":"string"
                      }
                    }
                  }
                }
              }
            }
,
            "multipart\/related":
            {
              "schema":
              {
                "type":"array",
                "prefixItems":
                [
                                    {
                    "type":"object"
                  }
,
                  
                  {
                    "type":"string",
                    "contentMediaType":"application\/pdf"
                  }
                ]
              }
,
              "prefixEncoding":
              [
                                {
                  "contentType":"application\/json"
                }
,
                
                {
                  "contentType":"application\/pdf"
                }
              ]
            }
,
            "multipart\/mixed":
            {
              "itemSchema":
              {
                "type":"string",
                "contentMediaType":"application\/pdf"
              }
,
              "itemEncoding":
              {
                "contentType":"application\/pdf"
              }
            }
          }
        }
,
        "responses":
        {
          "201":
          {
            "description":"The document was stored."
          }
        }
      }
,
      "additionalOperations":
      {
        "LINK":
        {
          "tags":
          [
            "Employee documents"
          ]
,
          "summary":"Links an existing document to the employee",
          "operationId":"linkEmployeeDocument",
          "parameters":
          [
                        {
              "name":"Link",
              "in":"header",
              "description":"The address of the document, as defined by RFC 8288.",
              "required":true,
              "schema":
              {
                "type":"string"
              }
            }
          ]
,
          "responses":
          {
            "204":
            {
              "description":"The document was linked."
            }
          }
        }
      }
    }
  }
,
  "webhooks":
  {
    "employeeHired":
    {
      "post":
      {
        "tags":
        [
          "Notifications"
        ]
,
        "summary":"An employee was hired",
        "description":"Sent to the client applications when an employee is created.",
        "operationId":"employeeHiredWebhook",
        "requestBody":
        {
          "required":true,
          "content":
          {
            "application\/json":
            {
              "schema":
              {
                "$ref":"#\/components\/schemas\/employeeResponse"
              }
            }
          }
        }
,
        "responses":
        {
          "200":
          {
            "description":"The client received the notification."
          }
        }
      }
    }
  }
,
  "components":
  {
    "schemas":
    {
      "employee":
      {
        "type":"object",
        "description":"Employee request data",
        "required":
        [
          "name",
          "gender"
        ]
,
        "properties":
        {
          "name":
          {
            "type":"string",
            "description":"The employee full name.",
            "maxLength":80
          }
,
          "phone":
          {
            "type":"string",
            "description":"The employee phone number."
          }
,
          "hireDate":
          {
            "type":"string",
            "description":"The employee hire date.",
            "format":"date"
          }
,
          "salary":
          {
            "type":"number",
            "description":"The employee gross salary."
          }
,
          "gender":
          {
            "type":"string",
            "description":"The employee gender.",
            "enum":
            [
              "male",
              "female"
            ]
          }
,
          "address":
          {
            "type":"object",
            "description":"The employee full address.",
            "properties":
            {
              "description":
              {
                "type":"string",
                "description":"The employee address description."
              }
,
              "city":
              {
                "type":"string",
                "description":"The employee address city."
              }
,
              "region":
              {
                "type":"string",
                "description":"The employee address region."
              }
,
              "country":
              {
                "type":"string",
                "description":"The employee address country."
              }
,
              "postalCode":
              {
                "type":"string",
                "description":"The employee address postal code."
              }
            }
          }
        }
      }
,
      "employeeResponse":
      {
        "type":"object",
        "description":"Employee response data",
        "required":
        [
          "name",
          "gender"
        ]
,
        "properties":
        {
          "id":
          {
            "type":"integer",
            "description":"The employee identification code.",
            "format":"int64"
          }
,
          "name":
          {
            "type":"string",
            "description":"The employee full name.",
            "maxLength":80
          }
,
          "phone":
          {
            "type":"string",
            "description":"The employee phone number."
          }
,
          "hireDate":
          {
            "type":"string",
            "description":"The employee hire date.",
            "format":"date"
          }
,
          "salary":
          {
            "type":"number",
            "description":"The employee gross salary."
          }
,
          "gender":
          {
            "type":"string",
            "description":"The employee gender.",
            "enum":
            [
              "male",
              "female"
            ]
          }
,
          "address":
          {
            "type":"object",
            "description":"The employee full address.",
            "properties":
            {
              "description":
              {
                "type":"string",
                "description":"The employee address description."
              }
,
              "city":
              {
                "type":"string",
                "description":"The employee address city."
              }
,
              "region":
              {
                "type":"string",
                "description":"The employee address region."
              }
,
              "country":
              {
                "type":"string",
                "description":"The employee address country."
              }
,
              "postalCode":
              {
                "type":"string",
                "description":"The employee address postal code."
              }
            }
          }
        }
      }
,
      "problem":
      {
        "type":"object",
        "description":"Problem details as defined by RFC 9457.",
        "properties":
        {
          "type":
          {
            "type":"string",
            "format":"uri-reference"
          }
,
          "title":
          {
            "type":"string"
          }
,
          "status":
          {
            "type":"integer",
            "format":"int32"
          }
,
          "detail":
          {
            "type":"string"
          }
        }
,
        "required":
        [
          "title",
          "status"
        ]
      }
    }
,
    "responses":
    {
      "notFound":
      {
        "description":"The employee was not found.",
        "content":
        {
          "application\/problem+json":
          {
            "schema":
            {
              "$ref":"#\/components\/schemas\/problem"
            }
          }
        }
      }
,
      "problem":
      {
        "description":"Unexpected error.",
        "content":
        {
          "application\/problem+json":
          {
            "schema":
            {
              "$ref":"#\/components\/schemas\/problem"
            }
          }
        }
      }
    }
,
    "parameters":
    {
      "id":
      {
        "name":"id",
        "in":"path",
        "description":"The employee identification code.",
        "required":true,
        "example":42,
        "schema":
        {
          "type":"integer",
          "format":"int64"
        }
      }
,
      "limit":
      {
        "name":"limit",
        "in":"query",
        "description":"The maximum number of employees returned.",
        "style":"form",
        "explode":true,
        "schema":
        {
          "type":"integer",
          "format":"int32",
          "default":20
        }
      }
    }
,
    "examples":
    {
      "employeeList":
      {
        "summary":"Two employees",
        "dataValue":
        [
                    {
            "id":42,
            "name":"John Smith",
            "gender":"male"
          }
,
          
          {
            "id":43,
            "name":"Mary Jones",
            "gender":"female"
          }
        ]
      }
,
      "employeeListCsv":
      {
        "summary":"Two employees as CSV",
        "serializedValue":"id,name,gender\n42,John Smith,male\n43,Mary Jones,female"
      }
    }
,
    "requestBodies":
    {
      "employee":
      {
        "description":"The employee data.",
        "required":true,
        "content":
        {
          "application\/json":
          {
            "schema":
            {
              "$ref":"#\/components\/schemas\/employee"
            }
,
            "examples":
            {
              "newEmployee":
              {
                "summary":"A new employee",
                "value":
                {
                  "name":"John Smith",
                  "gender":"male",
                  "hireDate":"2026-09-01",
                  "salary":5200.5
                }
              }
            }
          }
        }
      }
    }
,
    "headers":
    {
      "X-Rate-Limit-Remaining":
      {
        "description":"The number of requests left in the current period.",
        "example":99,
        "schema":
        {
          "type":"integer",
          "minimum":0
        }
      }
    }
,
    "securitySchemes":
    {
      "bearerAuth":
      {
        "type":"http",
        "description":"JSON Web Token sent in the Authorization header.",
        "scheme":"bearer",
        "bearerFormat":"JWT"
      }
,
      "apiKeyAuth":
      {
        "type":"apiKey",
        "description":"Key of the client application.",
        "in":"header",
        "name":"X-API-Key"
      }
,
      "oauth2Auth":
      {
        "type":"oauth2",
        "description":"OAuth 2.0 authorization server of the company.",
        "flows":
        {
          "authorizationCode":
          {
            "authorizationUrl":"https:\/\/auth.example.com\/authorize",
            "tokenUrl":"https:\/\/auth.example.com\/token",
            "refreshUrl":"https:\/\/auth.example.com\/refresh",
            "scopes":
            {
              "employees:read":"Reads the employees.",
              "employees:write":"Creates, updates and deletes the employees."
            }
          }
,
          "clientCredentials":
          {
            "tokenUrl":"https:\/\/auth.example.com\/token",
            "scopes":
            {
              "employees:read":"Reads the employees."
            }
          }
,
          "deviceAuthorization":
          {
            "deviceAuthorizationUrl":"https:\/\/auth.example.com\/device",
            "tokenUrl":"https:\/\/auth.example.com\/token",
            "scopes":
            {
              "employees:read":"Reads the employees."
            }
          }
        }
,
        "oauth2MetadataUrl":"https:\/\/auth.example.com\/.well-known\/oauth-authorization-server"
      }
,
      "openIdAuth":
      {
        "type":"openIdConnect",
        "openIdConnectUrl":"https:\/\/auth.example.com\/.well-known\/openid-configuration"
      }
,
